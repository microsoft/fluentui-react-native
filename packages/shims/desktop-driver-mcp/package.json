{
  "name": "@fluentui-react-native/desktop-driver-mcp",
  "version": "0.1.5",
  "description": "Deprecated driver-only compatibility wrapper for Desktop MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui-react-native.git",
    "directory": "packages/shims/desktop-driver-mcp"
  },
  "bin": "./config/cli.cjs",
  "files": [
    "AGENTS.md",
    "README.md",
    "config/",
    "lib/",
    "package.json",
    "references/",
    "src/",
    "!src/**/*.test.ts",
    "!lib/**/*.test.*"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "fluentui-scripts clean",
    "format": "fluentui-scripts format",
    "lint": "fluentui-scripts lint",
    "test": "fluentui-scripts jest"
  },
  "dependencies": {
    "@fluentui-react-native/desktop-mcp": "workspace:*"
  },
  "devDependencies": {
    "@fluentui-react-native/scripts": "workspace:*"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "deprecated": "Use @fluentui-react-native/desktop-mcp instead. For equivalent driver-only behavior, run desktop-mcp --driver-only.",
  "furn": {
    "jestPlatform": "react"
  },
  "rnx-kit": {
    "kitType": "library",
    "extends": "@fluentui-react-native/scripts/kit-config"
  }
}
