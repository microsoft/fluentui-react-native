  "_meta": {
    "description": "Default-value source mapping: each flex React Native token resolves its default value from the referenced FluentUI React Native / Fluent 2 (v9-compatible) token. The value prefix names the source collection.",
    "prefixes": {
      "alias.": "Themed semantic alias token — @fluentui-react-native/design-tokens-windows {light,dark}/tokens-aliases.json (theme.colors.alias.color<Name>).",
      "global.": "Raw global palette token — tokens-global.json, dot-path into the color tree (theme.colors.global.*). Theme-invariant.",
      "shadow.": "Elevation shadow token — tokens-shadow.json (theme.shadows.*)."
    },
    "direction": "flexToken <- fluentToken  (key = flex RN token, value = prefixed Fluent token reference)",
    "states": "Interactive alias-sourced tokens inherit alias interaction states: base uses <alias>.rest, hover.<token> uses <alias>.hover, pressed.<token> uses <alias>.pressed.",
    "fluentSource": "@fluentui-react-native/design-tokens-windows@0.56.0",
    "notes": [
      "global.* references are best-fit matches into the Fluent global palette; expression families map to the matching shared-color ramp step, gray to the grey ramp, alpha/translucent roles to the *Alpha ramps.",
      "color.materialBackground* map to whiteAlpha fallbacks — platform acrylic/vibrancy material (WinUI AcrylicBrush / NSVisualEffectView) is preferred where available.",
      "Non-color coverage here is limited to elevation shadow tokens; spacing/radius/typography/font-weight would source from Fluent global size/corner/font/stroke tokens."
    ]
  },
