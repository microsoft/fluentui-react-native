{
  "name": "@fluentui-react-native/desktop-driver",
  "version": "0.1.0",
  "description": "Write-once WebdriverIO desktop tests for React Native Windows and React Native macOS applications",
  "homepage": "https://github.com/microsoft/fluentui-react-native",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui-react-native.git",
    "directory": "packages/agentic/desktop-driver"
  },
  "bin": "./lib/cli/entry.js",
  "files": [
    "lib",
    "!lib/**/*.test.*",
    "!lib/driver-host/**",
    "!lib/storybook/announce.*",
    "!lib/storybook/channel-service.*",
    "!lib/storybook/controller.*",
    "!lib/storybook/run-executor.*",
    "!lib/storybook/serve.*",
    "!lib/storybook/test-service.*",
    "README.md",
    "USAGE.md",
    "DESIGN.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wdio": {
      "types": "./lib/wdio/index.d.ts",
      "default": "./lib/wdio/index.js"
    },
    "./storybook": {
      "types": "./lib/storybook/index.d.ts",
      "default": "./lib/storybook/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol/index.d.ts",
      "default": "./lib/protocol/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "default": "./lib/config/index.js"
    },
    "./config/node": {
      "types": "./lib/config/node.d.ts",
      "default": "./lib/config/node.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./macos": {
      "types": "./lib/platforms/macos.d.ts",
      "default": "./lib/platforms/macos.js"
    },
    "./windows": {
      "types": "./lib/platforms/windows.d.ts",
      "default": "./lib/platforms/windows.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "fluentui-scripts clean",
    "format": "fluentui-scripts format",
    "lint": "fluentui-scripts lint",
    "test": "fluentui-scripts jest"
  },
  "dependencies": {
    "@babel/parser": "^7.20.0",
    "appium": "catalog:",
    "appium-mac2-driver": "catalog:",
    "appium-novawindows-driver": "catalog:",
    "jiti": "catalog:",
    "webdriverio": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@fluentui-react-native/scripts": "workspace:*",
    "@types/node": "catalog:",
    "expect-webdriverio": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "furn": {
    "jestPlatform": "react",
    "depcheck": {
      "ignoreMatches": [
        "appium",
        "appium-mac2-driver",
        "appium-novawindows-driver"
      ]
    },
    "knip": {
      "extraEntries": [
        "src/**/*.test.ts"
      ]
    }
  },
  "rnx-kit": {
    "kitType": "library",
    "extends": "@fluentui-react-native/scripts/kit-config",
    "alignDeps": {
      "capabilities": []
    }
  }
}
