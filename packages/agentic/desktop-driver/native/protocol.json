{
  "schemaVersion": 1,
  "wireProtocol": {
    "major": 1,
    "minor": 0
  },
  "frame": {
    "magic": "FDR1",
    "headerBytes": 12,
    "jsonType": 1,
    "binaryType": 2
  },
  "macosApplicationOwnership": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "processStartedAt"],
      "properties": {
        "processId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "processStartedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        }
      }
    },
    "launchKind": ["launch-services", "direct-child"],
    "containment": ["uncontained", "external"],
    "applicationSettlement": ["exited", "unknown"],
    "launchServicesErrorFields": {
      "launchErrorDomain": { "type": "string", "maxLength": 163 },
      "launchErrorCode": { "type": "integer" },
      "underlyingErrorDomain": { "type": "string", "maxLength": 163 },
      "underlyingErrorCode": { "type": "integer" }
    },
    "failureMetadataLocations": ["response.error.data", "cancelled.data"]
  }
}
