{
  "schemaVersion": 1,
  "wireProtocol": {
    "major": 1,
    "minor": 0
  },
  "frame": {
    "magic": "FDR1",
    "headerBytes": 12,
    "jsonType": 1,
    "binaryType": 2,
    "helperStdin": {
      "dispatchedJsonTypes": ["request", "cancel"],
      "ignoresOtherJsonObjects": true,
      "ignoresBinaryPayloads": true
    }
  },
  "performActions": {
    "nodeFields": ["x", "y", "deltaX", "deltaY"],
    "nodeNumberRange": { "type": "number", "minimum": -2147483648, "maximum": 2147483647 },
    "originGeometry": {
      "origins": ["element", "viewport"],
      "requiresLivePositiveArea": true,
      "nativeErrorCode": "move-target-out-of-bounds",
      "webDriverErrorCode": "move target out of bounds"
    },
    "macos": {
      "coordinates": { "$ref": "#/performActions/nodeNumberRange" },
      "targetOwnership": {
        "pointerDownDragAndScroll": "window-of-exact-live-application-lease",
        "keyDown": "foreground-with-exact-live-application-lease",
        "activation": "at-most-once-before-first-key-press-without-proven-leased-foreground",
        "missingTargetErrorCode": "element-not-interactable",
        "releaseRequiresTargetOwnership": false,
        "unownedReleasePostsInput": false
      },
      "wheelConversion": {
        "input": "finite-number",
        "operation": "negate-round-clamp",
        "output": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      },
      "button": { "type": "integer", "minimum": 0, "maximum": 4 },
      "duration": { "type": "integer", "minimum": 0, "capMilliseconds": 30000 }
    }
  },
  "rangeValue": {
    "windows": {
      "get": "getRangeValue",
      "set": "setRangeValue",
      "feature": "rangeValue",
      "writeValue": "finite-number",
      "unsetReadValue": null
    }
  },
  "inputRecovery": {
    "mode": "--release-input",
    "ledgerFields": ["keys", "buttons"],
    "resultFields": ["releasedKeys", "releasedButtons"],
    "emptyLedger": {
      "postsInput": false,
      "lockWaitMilliseconds": 0,
      "whenUnavailableOrHeld": "success-with-zero-counts",
      "macosOwnerRecord": "require-exited-owner-and-match-supervisor-tag-when-supplied",
      "windowsMutex": "release-if-acquired"
    }
  },
  "windowsApplicationOwnership": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "processStartedAt", "executablePath", "interactiveSession"],
      "properties": {
        "processId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "processStartedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
        },
        "executablePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "interactiveSession": { "type": "string", "pattern": "^windows-session:[0-9]{1,10}$" },
        "aumid": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "identityInspection": {
      "command": "inspectApplication",
      "result": { "$ref": "#/windowsApplicationOwnership/processIdentity" },
      "acquiresLease": false,
      "registersWindows": false
    },
    "survivorRecovery": {
      "command": "recoverApplication",
      "identity": { "$ref": "#/windowsApplicationOwnership/processIdentity" },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state"],
        "properties": {
          "state": {
            "const": "exited",
            "description": "The recorded incarnation exited, including a reused PID whose live replacement is never signalled."
          }
        }
      },
      "trustedWorkloadOwnerOnly": true,
      "creationTimeQuery": "PROCESS_QUERY_LIMITED_INFORMATION",
      "pidReuseSettlement": "exited-without-signalling-current-process",
      "unreadableCreationTime": "fail-closed",
      "holdsApplicationControlLockForCleanup": true
    },
    "applicationControl": "session-local-nonwaiting-semaphore-pid-and-native-start",
    "ownershipFailureReasons": {
      "location": "response.error.data.reason",
      "values": [
        "identity-start-mismatch",
        "identity-session-mismatch",
        "identity-executable-mismatch",
        "identity-aumid-mismatch",
        "identity-user-mismatch",
        "application-identity-invalid",
        "application-identity-mismatch",
        "application-identity-changed",
        "application-identity-unknown",
        "application-identity-ambiguous",
        "application-exited",
        "no-matching-application",
        "application-window-missing",
        "application-lock-busy",
        "application-lock-unavailable",
        "application-preexisting",
        "application-recovery-unsettled"
      ]
    },
    "launchKind": ["direct-child", "packaged-activation"],
    "containment": ["job-object", "uncontained", "external"],
    "applicationSettlement": ["not-started", "exited", "unknown"],
    "failureMetadataFields": [
      "applicationSettlement",
      "processId",
      "processStartedAt",
      "executablePath",
      "interactiveSession",
      "aumid",
      "launchKind",
      "containment"
    ],
    "failureMetadataLocations": ["response.error.data", "cancelled.data"]
  },
  "macosApplicationOwnership": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "processStartedAt"],
      "properties": {
        "processId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "processStartedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        }
      }
    },
    "identityInspection": {
      "command": "inspectApplication",
      "result": { "$ref": "#/macosApplicationOwnership/processIdentity" },
      "acquiresLease": false,
      "registersWindows": false
    },
    "launchKind": ["launch-services", "direct-child"],
    "containment": ["uncontained", "external"],
    "applicationSettlement": ["not-started", "exited", "unknown"],
    "launchServicesErrorFields": {
      "launchErrorDomain": { "type": "string", "maxLength": 163 },
      "launchErrorCode": { "type": "integer" },
      "underlyingErrorDomain": { "type": "string", "maxLength": 163 },
      "underlyingErrorCode": { "type": "integer" }
    },
    "failureMetadataLocations": ["response.error.data", "cancelled.data"]
  }
}
