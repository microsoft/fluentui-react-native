{
  "name": "@fluentui-react-native/desktop-test",
  "version": "0.4.0",
  "description": "Application-neutral lifecycle and reporting for native desktop tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui-react-native.git",
    "directory": "packages/agentic/desktop-test"
  },
  "bin": "./config/cli.cjs",
  "files": [
    "AGENTS.md",
    "README.md",
    "config/",
    "lib/",
    "package.json",
    "references/",
    "src/",
    "!{lib,src}/**/*.test.*",
    "!{lib,src}/**/*.contract.*"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "import": "./lib/config.js",
      "default": "./src/config.ts"
    },
    "./control": {
      "types": "./lib/control.d.ts",
      "import": "./lib/control.js",
      "default": "./src/control.ts"
    },
    "./supervisor-connection": {
      "types": "./lib/supervisorConnection.d.ts",
      "import": "./lib/supervisorConnection.js",
      "default": "./src/supervisorConnection.ts"
    },
    "./managed-host": {
      "types": "./lib/managedHost.d.ts",
      "import": "./lib/managedHost.js",
      "default": "./src/managedHost.ts"
    },
    "./reporting": {
      "types": "./lib/reporting/index.d.ts",
      "import": "./lib/reporting/index.js",
      "default": "./src/reporting/index.ts"
    },
    "./reporting/run-queries": {
      "types": "./lib/reporting/runQueries.d.ts",
      "import": "./lib/reporting/runQueries.js",
      "default": "./src/reporting/runQueries.ts"
    },
    "./commands": {
      "types": "./lib/commands.d.ts",
      "import": "./lib/commands.js",
      "default": "./src/commands.ts"
    },
    "./driver-service": {
      "types": "./lib/driverService.d.ts",
      "import": "./lib/driverService.js",
      "default": "./src/driverService.ts"
    },
    "./process-control": {
      "types": "./lib/processControl.d.ts",
      "import": "./lib/processControl.js",
      "default": "./src/processControl.ts"
    },
    "./resources": {
      "types": "./lib/resources.d.ts",
      "import": "./lib/resources.js",
      "default": "./src/resources.ts"
    },
    "./ownership": {
      "types": "./lib/ownership.d.ts",
      "import": "./lib/ownership.js",
      "default": "./src/ownership.ts"
    },
    "./application-ownership": {
      "types": "./lib/applicationOwnership.d.ts",
      "import": "./lib/applicationOwnership.js",
      "default": "./src/applicationOwnership.ts"
    },
    "./macos-application-inspection": {
      "types": "./lib/macosApplicationInspector.d.ts",
      "import": "./lib/macosApplicationInspector.js",
      "default": "./src/macosApplicationInspector.ts"
    },
    "./jasmine": {
      "types": "./lib/jasmine/index.d.ts",
      "import": "./lib/jasmine/index.js",
      "default": "./src/jasmine/index.ts"
    },
    "./wdio": {
      "types": "./lib/wdio/index.d.ts",
      "import": "./lib/wdio/index.js",
      "default": "./src/wdio/index.ts"
    },
    "./runner-connection": {
      "types": "./lib/wdio/runnerConnection.d.ts",
      "import": "./lib/wdio/runnerConnection.js",
      "default": "./src/wdio/runnerConnection.ts"
    },
    "./service": "./config/service.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "fluentui-scripts clean",
    "format": "fluentui-scripts format",
    "lint": "fluentui-scripts lint",
    "test": "fluentui-scripts jest"
  },
  "dependencies": {
    "@fluentui-react-native/desktop-driver": "workspace:*",
    "@wdio/reporter": "catalog:",
    "commander": "^14.0.2",
    "cross-spawn": "7.0.6",
    "import-meta-resolve": "4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fluentui-react-native/scripts": "workspace:*",
    "@types/cross-spawn": "6.0.6",
    "@wdio/cli": "catalog:",
    "@wdio/jasmine-framework": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/runner": "catalog:",
    "expect-webdriverio": "catalog:",
    "webdriverio": "catalog:"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "furn": {
    "jestPlatform": "react"
  },
  "rnx-kit": {
    "kitType": "library",
    "extends": "@fluentui-react-native/scripts/kit-config"
  }
}
