{
  "schemaVersion": 2,
  "component": "compound-button",
  "implementation": "compound-button.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["appearance", ["primary", "secondary", "outline", "subtle"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "maxWidth": 280,
      "minHeight": 60,
      "when.size.small": {
        "minHeight": 48
      },
      "when.size.large": {
        "minHeight": 68
      }
    },
    "image": {
      "width": 40,
      "height": 40,
      "when.size.small": {
        "width": 32,
        "height": 32,
        "borderRadius": "tokens:borderRadius.base100"
      },
      "when.size.large": {
        "width": 40,
        "height": 40
      },
      "borderRadius": "tokens:borderRadius.base200"
    },
    "contentStack": {
      "flexShrink": 1,
      "alignItems": "flex-start"
    },
    "description": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "when.appearance.primary": {
        "color": "tokens:color.foregroundBrandOnloud.rest"
      },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": []
}
