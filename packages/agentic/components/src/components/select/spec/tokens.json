{
  "schemaVersion": 2,
  "component": "select",
  "implementation": "select.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["variant", ["outline", "underline"]],
    ["visualState", ["rest", "hovered", "focused", "error", "disabled"]]
  ],
  "bindings": {
    "root": {
      "minHeight": 32,
      "when.size.small": {
        "minHeight": 24
      },
      "when.size.large": {
        "minHeight": 40
      },
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest"
    },
    "chrome": {
      "borderColor": "tokens:color.strokeNeutralLoud.active",
      "when.variant.outline": {
        "borderWidth": "tokens:strokeWidth.thin"
      },
      "when.variant.underline": {
        "borderBottomWidth": "tokens:strokeWidth.thin"
      },
      "when.visualState.error": {
        "borderColor": "tokens:color.strokeDangerLoud.rest"
      },
      "when.visualState.disabled": {
        "borderColor": "tokens:color.strokeNeutralDisabled.rest"
      }
    },
    "display": {
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "placeholder": {
      "color": "tokens:color.foregroundNeutralTertiary.rest",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": [
    {
      "binding": "nativePicker",
      "detail": "Bindings apply only to chrome the actual picker supports. Option surface, disclosure and focus may be wholly system rendered."
    }
  ]
}
