{
  "schemaVersion": 2,
  "component": "color-area",
  "implementation": "color-area.styles.ts",
  "axes": [
    ["shape", ["rectangular", "rounded"]],
    ["visualState", ["rest", "hovered", "pressed"]]
  ],
  "bindings": {
    "surface": {
      "overflow": "hidden",
      "borderWidth": "tokens:strokeWidth.thin",
      "borderRadius": "tokens:borderRadius.base100",
      "borderColor": "tokens:color.strokeNeutralSubtle.rest",
      "when.shape.rounded": {
        "borderRadius": "tokens:borderRadius.base300"
      }
    },
    "thumb": {
      "width": 24,
      "height": 24,
      "borderRadius": "tokens:borderRadius.circular",
      "borderWidth": "tokens:strokeWidth.thin",
      "borderColor": "tokens:color.strokeNeutralHeavy.active"
    },
    "innerRing": {
      "borderWidth": "tokens:strokeWidth.thick",
      "borderColor": "tokens:color.foregroundNeutralOnloud.active",
      "borderRadius": "tokens:borderRadius.circular"
    },
    "sample": {
      "width": 18,
      "height": 18,
      "borderRadius": "tokens:borderRadius.circular"
    }
  },
  "tokenGaps": [
    {
      "binding": "runtimeGradient",
      "detail": "Compute hue and coordinate samples from the actual edited color. The subtle boundary is not evidence of sufficient contrast; qualify a system-color boundary where needed."
    }
  ]
}
