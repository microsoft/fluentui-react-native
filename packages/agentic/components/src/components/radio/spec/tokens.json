{
  "schemaVersion": 2,
  "component": "radio",
  "implementation": "radio.styles.ts",
  "axes": [
    ["selected", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "alignItems": "center",
      "alignSelf": "flex-start",
      "flexDirection": "row",
      "flexShrink": 1,
      "justifyContent": "flex-start",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
      "borderRadius": "tokens:borderRadius.base300",
      "gap": "tokens:spacing.componentBase100"
    },
    "indicator": {
      "alignItems": "center",
      "flexShrink": 0,
      "justifyContent": "center",
      "borderStyle": "solid",
      "borderWidth": "tokens:strokeWidth.thin",
      "borderRadius": 8,
      "height": 16,
      "width": 16,
      "margin": "tokens:spacing.componentBase200",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
      "borderColor": "tokens:color.strokeNeutralHeavy.active",
      "when.visualState.disabled": { "borderColor": "tokens:color.strokeNeutralDisabled.rest" }
    },
    "dot": {
      "flexShrink": 0,
      "borderRadius": 5,
      "height": 10,
      "width": 10,
      "backgroundColor": "tokens:color.foregroundNeutralPrimary.active",
      "when.visualState.disabled": { "backgroundColor": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "labelContainer": {
      "flexShrink": 1,
      "justifyContent": "center",
      "minWidth": 0,
      "gap": "tokens:spacing.componentBase50",
      "paddingEnd": "tokens:spacing.componentBase200",
      "paddingVertical": "tokens:spacing.componentBase150"
    },
    "label": {
      "flexShrink": 1,
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "color": "tokens:color.foregroundNeutralSecondary.active",
      "when.selected.true": { "color": "tokens:color.foregroundNeutralPrimary.active" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "secondaryText": {
      "flexShrink": 1,
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "color": "tokens:color.foregroundNeutralSecondary.active",
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    }
  },
  "tokenGaps": []
}
