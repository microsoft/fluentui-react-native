{
  "schemaVersion": 2,
  "component": "card",
  "implementation": "card.styles.ts",
  "axes": [
    ["size", ["small", "large"]],
    ["padding", ["default", "none"]],
    ["resolvedDirection", ["vertical", "horizontal"]],
    ["selected", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "backgroundColor": "tokens:color.surfaceNeutralTranslucent.active",
      "borderColor": "tokens:color.strokeNeutralSubtle.active",
      "borderRadius": "tokens:borderRadius.base600",
      "borderWidth": "tokens:strokeWidth.thin",
      "flexDirection": "column",
      "gap": "tokens:spacing.componentBase300",
      "padding": "tokens:spacing.componentBase300",
      "when.size.large": { "borderRadius": "tokens:borderRadius.base700" },
      "when.padding.none": { "padding": 0 },
      "when.resolvedDirection.horizontal": { "flexDirection": "row" },
      "when.selected.true": {
        "backgroundColor": "tokens:color.backgroundNeutralSoft.active",
        "borderColor": "tokens:color.strokeNeutralSoft.active"
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest",
        "borderColor": "tokens:color.strokeNeutralDisabled.rest"
      }
    },
    "nestedContent": { "backgroundColor": "tokens:color.backgroundNeutralTranslucent.rest" }
  },
  "tokenGaps": [
    {
      "binding": "responsive layout",
      "detail": "Horizontal direction falls back to vertical below a 480-unit window width; the root caps its extent at 720 units."
    }
  ]
}
