{
  "schemaVersion": 2,
  "component": "presence-badge",
  "implementation": "presence-badge.styles.ts",
  "axes": [
    ["size", ["extraSmall", "small", "medium", "large"]],
    ["status", ["available", "busy", "doNotDisturb", "away", "offline", "outOfOffice"]]
  ],
  "bindings": {
    "root": {
      "borderRadius": "tokens:borderRadius.circular",
      "alignItems": "center",
      "justifyContent": "center",
      "when.size.extraSmall": {
        "width": 10,
        "height": 10
      },
      "when.size.small": {
        "width": 12,
        "height": 12
      },
      "when.size.medium": {
        "width": 16,
        "height": 16
      },
      "when.size.large": {
        "width": 20,
        "height": 20
      }
    },
    "mark": {
      "when.size.extraSmall": {
        "width": 8,
        "height": 8
      },
      "when.size.small": {
        "width": 10,
        "height": 10
      },
      "when.size.medium": {
        "width": 12,
        "height": 12
      },
      "when.size.large": {
        "width": 16,
        "height": 16
      },
      "when.status.available": {
        "color": "tokens:color.foregroundSuccessPrimary.rest"
      },
      "when.status.busy": {
        "color": "tokens:color.foregroundDangerPrimary.rest"
      },
      "when.status.doNotDisturb": {
        "color": "tokens:color.foregroundDangerPrimary.rest"
      },
      "when.status.away": {
        "color": "tokens:color.foregroundWarningPrimary.rest"
      },
      "when.status.offline": {
        "color": "tokens:color.foregroundNeutralTertiary.rest"
      },
      "when.status.outOfOffice": {
        "color": "tokens:color.foregroundNeutralTertiary.rest"
      }
    }
  },
  "tokenGaps": []
}
