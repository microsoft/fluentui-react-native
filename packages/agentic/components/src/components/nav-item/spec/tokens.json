{
  "schemaVersion": 2,
  "component": "nav-item",
  "implementation": "nav-item.styles.ts",
  "axes": [
    ["density", ["comfortable", "compact"]],
    ["highlighted", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "primary": {
      "flexDirection": "row",
      "alignItems": "center",
      "gap": "tokens:spacing.componentBase150",
      "paddingVertical": "tokens:spacing.componentBase250",
      "paddingHorizontal": "tokens:spacing.componentBase300",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "when.density.compact": {
        "gap": "tokens:spacing.componentBase100",
        "paddingVertical": "tokens:spacing.componentBase150",
        "paddingHorizontal": "tokens:spacing.componentBase200"
      },
      "when.highlighted.true": {
        "backgroundColor": "tokens:color.backgroundNeutralSoft.active"
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest"
      }
    },
    "leading": {
      "width": 20,
      "height": 20,
      "when.density.compact": {
        "width": 16,
        "height": 16
      }
    },
    "label": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "flexShrink": 1,
      "when.highlighted.true": {
        "fontWeight": "tokens:fontWeight.functionalSemibold"
      },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "indicator": {
      "backgroundColor": "tokens:color.strokeBrandLoud.rest",
      "width": "tokens:strokeWidth.thick"
    }
  },
  "tokenGaps": []
}
