{
  "schemaVersion": 2,
  "component": "avatar-group",
  "implementation": "avatar-group.styles.ts",
  "axes": [["size", [16, 20, 24, 28, 32, 40, 56, 120]]],
  "bindings": {
    "root": {
      "gap": "tokens:spacing.componentBase300",
      "when.size.16": { "gap": "tokens:spacing.componentBase200" },
      "when.size.20": { "gap": "tokens:spacing.componentBase250" },
      "when.size.24": { "gap": "tokens:spacing.componentBase250" },
      "when.size.28": { "gap": "tokens:spacing.componentBase250" },
      "when.size.120": { "gap": "tokens:spacing.componentBase500" }
    },
    "overflow": {
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.surfaceNeutralNearer.rest",
      "paddingHorizontal": "tokens:spacing.componentBase100",
      "when.size.16": { "paddingHorizontal": 0 },
      "when.size.20": { "paddingHorizontal": "tokens:spacing.componentBase50" }
    },
    "count": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.size.16": { "fontSize": "tokens:fontSize.functionalCaption", "lineHeight": "tokens:lineHeight.functionalCaption" },
      "when.size.20": { "fontSize": "tokens:fontSize.functionalCaption", "lineHeight": "tokens:lineHeight.functionalCaption" },
      "when.size.24": { "fontSize": "tokens:fontSize.functionalCaption", "lineHeight": "tokens:lineHeight.functionalCaption" },
      "when.size.28": { "fontSize": "tokens:fontSize.functionalBodySmall", "lineHeight": "tokens:lineHeight.functionalBodySmall" },
      "when.size.40": { "fontSize": "tokens:fontSize.functionalBodyLarge", "lineHeight": "tokens:lineHeight.functionalBodyLarge" },
      "when.size.56": { "fontSize": "tokens:fontSize.functionalTitleSmall", "lineHeight": "tokens:lineHeight.functionalTitleSmall" },
      "when.size.120": { "fontSize": "tokens:fontSize.functionalTitleLarge", "lineHeight": "tokens:lineHeight.functionalTitleLarge" }
    }
  },
  "tokenGaps": [
    {
      "binding": "stackCutout",
      "detail": "A transparent mask and measured overlap belong to the native stack layout, not a fill color. Verify over nonuniform backgrounds."
    }
  ]
}
