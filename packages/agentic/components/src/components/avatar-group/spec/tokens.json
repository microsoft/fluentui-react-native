{
  "schemaVersion": 2,
  "component": "avatar-group",
  "implementation": "avatar-group.styles.ts",
  "axes": [
    ["layout", ["spread", "stack"]],
    ["size", [16, 20, 24, 28, 32, 40, 56, 120]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "when.layout.spread": {
        "when.size.16": {
          "gap": "tokens:spacing.componentBase200"
        },
        "when.size.20": {
          "gap": "tokens:spacing.componentBase250"
        },
        "when.size.24": {
          "gap": "tokens:spacing.componentBase250"
        },
        "when.size.28": {
          "gap": "tokens:spacing.componentBase250"
        },
        "when.size.32": {
          "gap": "tokens:spacing.componentBase300"
        },
        "when.size.40": {
          "gap": "tokens:spacing.componentBase300"
        },
        "when.size.56": {
          "gap": "tokens:spacing.componentBase300"
        },
        "when.size.120": {
          "gap": "tokens:spacing.componentBase500"
        }
      },
      "when.layout.stack": {
        "gap": 0
      }
    },
    "overflow": {
      "alignItems": "center",
      "justifyContent": "center",
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.surfaceNeutralNearer.rest",
      "when.size.16": {
        "width": 16,
        "height": 16
      },
      "when.size.20": {
        "width": 20,
        "height": 20
      },
      "when.size.24": {
        "width": 24,
        "height": 24
      },
      "when.size.28": {
        "width": 28,
        "height": 28
      },
      "when.size.32": {
        "width": 32,
        "height": 32
      },
      "when.size.40": {
        "width": 40,
        "height": 40
      },
      "when.size.56": {
        "width": 56,
        "height": 56
      },
      "when.size.120": {
        "width": 120,
        "height": 120
      }
    },
    "count": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest"
    }
  },
  "tokenGaps": [
    {
      "binding": "stackCutout",
      "detail": "A transparent mask and measured overlap belong to the native stack layout, not a fill color. Verify over nonuniform backgrounds."
    }
  ]
}
