{
  "schemaVersion": 2,
  "component": "destructive-button",
  "implementation": "destructive-button.styles.ts",
  "axes": [
    ["appearance", ["primary", "subtle"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "when.appearance.primary": {
        "backgroundColor": "tokens:color.backgroundDangerLoud.active",
        "when.visualState.disabled": {
          "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest"
        }
      },
      "when.appearance.subtle": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
        "when.visualState.hovered": {
          "backgroundColor": "tokens:color.backgroundDangerSubtle.hover"
        },
        "when.visualState.pressed": {
          "backgroundColor": "tokens:color.backgroundDangerSubtle.pressed"
        }
      }
    },
    "content": {
      "when.appearance.primary": {
        "color": "tokens:color.foregroundDangerOnloud.active"
      },
      "when.appearance.subtle": {
        "color": "tokens:color.foregroundDangerPrimary.active"
      },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "icon": {
      "when.appearance.primary": {
        "color": "tokens:color.foregroundDangerOnloud.active"
      },
      "when.appearance.subtle": {
        "color": "tokens:color.foregroundDangerPrimary.active"
      },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": []
}
