{
  "schemaVersion": 2,
  "component": "split-button",
  "implementation": "split-button.styles.ts",
  "axes": [
    ["appearance", ["primary", "secondary", "outline"]],
    ["size", ["small", "medium", "large"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "minHeight": 32,
      "when.size.small": {
        "minHeight": 24
      },
      "when.size.large": {
        "minHeight": 40
      }
    },
    "divider": {
      "width": "tokens:strokeWidth.thin",
      "alignSelf": "stretch",
      "backgroundColor": "tokens:color.strokeNeutralSubtle.rest",
      "when.appearance.primary": {
        "backgroundColor": "tokens:color.strokeNeutralOnloud.rest"
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.strokeNeutralDisabled.rest"
      }
    },
    "menuRegion": {
      "minWidth": 24
    },
    "chevron": {
      "width": 20,
      "height": 20,
      "when.size.small": {
        "width": 16,
        "height": 16,
        "source": "fluent-icon: ChevronDown16Regular"
      },
      "when.size.large": {
        "width": 20,
        "height": 20
      },
      "source": "fluent-icon: ChevronDown20Regular"
    }
  },
  "tokenGaps": []
}
