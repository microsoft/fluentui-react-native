{
  "schemaVersion": 2,
  "component": "menu-item",
  "implementation": "menu-item.styles.ts",
  "axes": [
    ["menuStyle", ["list-item", "section-header"]],
    ["isSelectedVisual", [false, true]],
    ["selected", [false, true]],
    ["secondaryContentPosition", ["right", "under"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "borderRadius": "tokens:borderRadius.base300",
      "paddingHorizontal": "tokens:spacing.componentBase300",
      "paddingVertical": "tokens:spacing.componentBase250",
      "gap": "tokens:spacing.componentBase150",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "when.menuStyle.section-header": { "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest" },
      "when.isSelectedVisual.true": {
        "backgroundColor": "tokens:color.backgroundNeutralSoft.active",
        "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest" }
      }
    },
    "content": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "gap": "tokens:spacing.componentBase150",
      "when.secondaryContentPosition.under": { "gap": "tokens:spacing.componentBase100" },
      "when.menuStyle.section-header": {
        "fontSize": "tokens:fontSize.functionalBodySmall",
        "lineHeight": "tokens:lineHeight.functionalBodySmall",
        "fontWeight": "tokens:fontWeight.functionalSemibold"
      },
      "when.isSelectedVisual.true": { "fontWeight": "tokens:fontWeight.functionalSemibold" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "secondaryContent": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralSecondary.active",
      "when.menuStyle.section-header": { "color": "tokens:color.foregroundNeutralPrimary.rest" },
      "when.isSelectedVisual.true": {
        "fontWeight": "tokens:fontWeight.functionalSemibold",
        "color": "tokens:color.foregroundNeutralPrimary.active"
      },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "leadingIcon": { "width": 20, "height": 20 },
    "trailingIcon": { "width": 20, "height": 20 },
    "checkmark": { "width": 16, "height": 16 },
    "avatar": { "width": 16, "height": 16 },
    "checkbox": {
      "width": 16,
      "height": 16,
      "iconSize": 12,
      "borderRadius": "tokens:borderRadius.base200",
      "borderWidth": "tokens:strokeWidth.thin",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
      "borderColor": "tokens:color.strokeNeutralHeavy.rest",
      "iconColor": "tokens:color.foregroundNeutralOnloud.active",
      "when.selected.true": {
        "backgroundColor": "tokens:color.backgroundNeutralHeavy.active",
        "borderColor": "tokens:color.strokeNeutralTransparent.active",
        "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest" }
      },
      "when.visualState.disabled": {
        "borderColor": "tokens:color.strokeNeutralDisabled.rest",
        "iconColor": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": []
}
