{
  "schemaVersion": 2,
  "component": "list",
  "implementation": "list.styles.ts",
  "axes": [["size", ["small", "medium", "large"]]],
  "bindings": {
    "root": {
      "flexDirection": "column",
      "gap": 0,
      "padding": 0,
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest"
    },
    "item": {
      "when.size.small": {
        "size": "small"
      },
      "when.size.medium": {
        "size": "medium"
      },
      "when.size.large": {
        "size": "large"
      }
    }
  },
  "tokenGaps": []
}
