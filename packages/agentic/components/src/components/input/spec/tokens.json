{
  "schemaVersion": 2,
  "component": "input",
  "implementation": "input.styles.ts",
  "axes": [
    ["variant", ["outline", "underline"]],
    ["size", ["small", "medium", "large"]],
    ["visualState", ["rest", "hovered", "pressed", "focused", "error", "disabled", "readOnly"]]
  ],
  "bindings": {
    "root": {
      "borderRadius": 0,
      "when.variant.outline": {
        "when.size.small": { "borderRadius": "tokens:borderRadius.base200" },
        "when.size.medium": { "borderRadius": "tokens:borderRadius.base300" },
        "when.size.large": { "borderRadius": "tokens:borderRadius.base400" }
      }
    },
    "contents": {
      "gap": "tokens:spacing.componentBase250",
      "borderWidth": 0,
      "when.size.small": {
        "minHeight": 24,
        "paddingTop": "tokens:spacing.componentBase100",
        "paddingBottom": "tokens:spacing.componentBase100"
      },
      "when.size.medium": {
        "minHeight": 32,
        "paddingTop": "tokens:spacing.componentBase150",
        "paddingBottom": "tokens:spacing.componentBase150"
      },
      "when.size.large": {
        "minHeight": 40,
        "paddingTop": "tokens:spacing.componentBase200",
        "paddingBottom": "tokens:spacing.componentBase200"
      },
      "when.variant.outline": {
        "borderWidth": "tokens:strokeWidth.thin",
        "borderColor": "tokens:color.strokeNeutralLoud.active",
        "when.visualState.focused": { "borderColor": "tokens:color.strokeNeutralSubtle.rest" },
        "when.visualState.error": { "borderColor": "tokens:color.strokeDangerLoud.rest" },
        "when.visualState.disabled": { "borderColor": "tokens:color.strokeNeutralDisabled.rest" },
        "when.visualState.readOnly": { "borderColor": "tokens:color.strokeNeutralDisabled.rest" }
      }
    },
    "iconTextStack": {
      "gap": "tokens:spacing.componentBase250",
      "when.size.small": { "paddingStart": "tokens:spacing.componentBase150", "paddingEnd": "tokens:spacing.componentBase150" },
      "when.size.medium": { "paddingStart": "tokens:spacing.componentBase250", "paddingEnd": "tokens:spacing.componentBase250" },
      "when.size.large": { "paddingStart": "tokens:spacing.componentBase300", "paddingEnd": "tokens:spacing.componentBase300" }
    },
    "iconEnd": {
      "gap": "tokens:spacing.componentBase100",
      "when.size.small": { "paddingEnd": "tokens:spacing.componentBase100" },
      "when.size.medium": { "paddingEnd": "tokens:spacing.componentBase150" },
      "when.size.large": { "paddingEnd": "tokens:spacing.componentBase150" }
    },
    "textInput": {
      "fontFamily": "tokens:fontFamily.functional",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "placeholderTextColor": "tokens:color.foregroundNeutralTertiary.rest",
      "when.size.small": { "fontSize": "tokens:fontSize.functionalBodySmall" },
      "when.size.medium": { "fontSize": "tokens:fontSize.functionalBodyMedium" },
      "when.size.large": { "fontSize": "tokens:fontSize.functionalBodyLarge" },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest",
        "placeholderTextColor": "tokens:color.foregroundNeutralDisabled.rest"
      },
      "when.visualState.readOnly": { "placeholderTextColor": "tokens:color.foregroundNeutralPrimary.rest" }
    },
    "underline": {
      "borderBottomWidth": "tokens:strokeWidth.thin",
      "borderBottomColor": "tokens:color.strokeNeutralLoud.active",
      "when.visualState.focused": { "borderBottomColor": "tokens:color.strokeFocusOuter.rest" },
      "when.visualState.error": { "borderBottomColor": "tokens:color.strokeDangerLoud.rest" },
      "when.visualState.disabled": { "borderBottomColor": "tokens:color.strokeNeutralDisabled.rest" },
      "when.visualState.readOnly": { "borderBottomColor": "tokens:color.strokeNeutralDisabled.rest" }
    },
    "underlineFocus": {
      "borderBottomWidth": "tokens:strokeWidth.thin",
      "borderBottomColor": "tokens:color.strokeFocusOuter.rest"
    },
    "icon": {
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.size.small": { "height": 16, "width": 16 },
      "when.size.medium": { "height": 20, "width": 20 },
      "when.size.large": { "height": 24, "width": 24 },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    }
  },
  "tokenGaps": []
}
