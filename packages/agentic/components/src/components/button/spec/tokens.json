{
  "schemaVersion": 2,
  "component": "button",
  "implementation": "button.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["shape", ["rounded", "square", "circle"]],
    ["iconOnly", [false, true]],
    ["appearance", ["primary", "secondary", "outline", "subtle"]],
    ["selected", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "alignItems": "center",
      "alignSelf": "flex-start",
      "borderStyle": "solid",
      "flexDirection": "row",
      "justifyContent": "center",
      "borderWidth": "tokens:strokeWidth.thin",
      "minHeight": 24,
      "minWidth": 24,
      "when.size.small": {
        "borderRadius": "tokens:borderRadius.base200",
        "paddingHorizontal": "tokens:spacing.componentBase200",
        "paddingVertical": "tokens:spacing.componentBase100",
        "when.iconOnly.false": { "gap": "tokens:spacing.componentBase50" },
        "when.iconOnly.true": { "paddingHorizontal": "tokens:spacing.componentBase100" }
      },
      "when.size.medium": {
        "borderRadius": "tokens:borderRadius.base300",
        "paddingHorizontal": "tokens:spacing.componentBase250",
        "paddingVertical": "tokens:spacing.componentBase150",
        "when.iconOnly.false": { "gap": "tokens:spacing.componentBase100" },
        "when.iconOnly.true": { "paddingHorizontal": "tokens:spacing.componentBase150" }
      },
      "when.size.large": {
        "borderRadius": "tokens:borderRadius.base400",
        "paddingHorizontal": "tokens:spacing.componentBase300",
        "paddingVertical": "tokens:spacing.componentBase200",
        "when.iconOnly.false": { "gap": "tokens:spacing.componentBase150" },
        "when.iconOnly.true": {
          "paddingHorizontal": "tokens:spacing.componentBase250",
          "paddingVertical": "tokens:spacing.componentBase250"
        }
      },
      "when.shape.square": { "borderRadius": 0 },
      "when.shape.circle": { "borderRadius": "tokens:borderRadius.circular" },
      "when.appearance.primary": {
        "backgroundColor": "tokens:color.backgroundBrandHeavy.active",
        "borderColor": "tokens:color.strokeNeutralTransparent.active",
        "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest" }
      },
      "when.appearance.secondary": {
        "backgroundColor": "tokens:color.backgroundNeutralSubtle.active",
        "borderColor": "tokens:color.strokeNeutralTransparent.active",
        "when.selected.true": {
          "backgroundColor": "tokens:color.backgroundNeutralHeavy.active",
          "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest" }
        },
        "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest" }
      },
      "when.appearance.outline": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
        "borderColor": "tokens:color.strokeNeutralLoud.active",
        "when.selected.true": {
          "backgroundColor": "tokens:color.backgroundNeutralHeavy.active",
          "borderColor": "tokens:color.strokeNeutralHeavy.active",
          "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest" }
        },
        "when.visualState.disabled": { "borderColor": "tokens:color.strokeNeutralDisabled.rest" }
      },
      "when.appearance.subtle": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
        "borderColor": "tokens:color.strokeNeutralTransparent.active",
        "when.selected.false": {
          "when.visualState.hovered": { "backgroundColor": "tokens:color.backgroundNeutralSubtle.hover" },
          "when.visualState.pressed": { "backgroundColor": "tokens:color.backgroundNeutralSubtle.pressed" }
        },
        "when.selected.true": {
          "backgroundColor": "tokens:color.backgroundNeutralSoft.active",
          "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest" }
        }
      }
    },
    "content": {
      "flexShrink": 1,
      "textAlign": "center",
      "fontFamily": "tokens:fontFamily.functional",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.size.small": {
        "fontSize": "tokens:fontSize.functionalBodySmall",
        "lineHeight": "tokens:lineHeight.functionalBodySmall"
      },
      "when.size.medium": {
        "fontSize": "tokens:fontSize.functionalBodyMedium",
        "lineHeight": "tokens:lineHeight.functionalBodyMedium"
      },
      "when.size.large": {
        "fontSize": "tokens:fontSize.functionalBodyLarge",
        "lineHeight": "tokens:lineHeight.functionalBodyLarge"
      },
      "when.appearance.primary": { "color": "tokens:color.foregroundBrandOnloud.active" },
      "when.appearance.secondary": {
        "when.selected.true": { "color": "tokens:color.foregroundNeutralOnloud.active" }
      },
      "when.appearance.outline": {
        "when.selected.true": { "color": "tokens:color.foregroundNeutralOnloud.active" }
      },
      "when.selected.true": { "fontWeight": "tokens:fontWeight.functionalSemibold" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "icon": {
      "width": 20,
      "height": 20,
      "when.size.small": { "width": 16, "height": 16 }
    }
  },
  "tokenGaps": []
}
