{
  "schemaVersion": 2,
  "component": "message-bar",
  "implementation": "message-bar.styles.ts",
  "axes": [["status", ["information", "warning", "error", "success"]]],
  "bindings": {
    "root": {
      "backgroundColor": "tokens:color.surfaceNeutralNearer.rest",
      "borderRadius": "tokens:borderRadius.base400",
      "gap": "tokens:spacing.componentBase200",
      "padding": "tokens:spacing.componentBase300"
    },
    "statusIcon": {
      "width": 20,
      "height": 20,
      "when.status.information": {
        "source": "fluent-icon: Info20Regular",
        "color": "tokens:color.foregroundNeutralPrimary.rest"
      },
      "when.status.warning": {
        "source": "fluent-icon: Warning20Regular",
        "color": "tokens:color.foregroundWarningPrimary.rest"
      },
      "when.status.error": {
        "source": "fluent-icon: DiamondDismiss20Regular",
        "color": "tokens:color.foregroundDangerPrimary.rest"
      },
      "when.status.success": {
        "source": "fluent-icon: CheckmarkCircle20Regular",
        "color": "tokens:color.foregroundSuccessPrimary.rest"
      }
    },
    "content": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "flexShrink": 1
    },
    "actions": {
      "flexDirection": "row",
      "alignItems": "center",
      "flexWrap": "wrap",
      "gap": "tokens:spacing.componentBase200"
    },
    "dismiss": {
      "size": "small",
      "appearance": "subtle"
    },
    "tint": {
      "when.status.information": {
        "backgroundColor": "tokens:color.backgroundNeutralSubtle.rest"
      },
      "when.status.warning": {
        "backgroundColor": "tokens:color.backgroundWarningSubtle.rest"
      },
      "when.status.error": {
        "backgroundColor": "tokens:color.backgroundDangerSubtle.rest"
      },
      "when.status.success": {
        "backgroundColor": "tokens:color.backgroundSuccessSubtle.rest"
      }
    }
  },
  "tokenGaps": []
}
