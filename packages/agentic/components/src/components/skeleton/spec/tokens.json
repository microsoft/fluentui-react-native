{
  "schemaVersion": 2,
  "component": "skeleton",
  "implementation": "skeleton.styles.ts",
  "axes": [["silhouette", ["animated", "static", "opaque"]]],
  "bindings": {
    "root": {
      "overflow": "hidden",
      "position": "relative",
      "backgroundColor": "tokens:color.backgroundNeutralSubtle.rest",
      "borderRadius": "tokens:borderRadius.base100",
      "when.silhouette.static": { "borderColor": "tokens:color.strokeNeutralSubtle.rest", "borderWidth": "tokens:strokeWidth.thin" },
      "when.silhouette.opaque": { "borderColor": "tokens:color.strokeNeutralLoud.rest", "borderWidth": "tokens:strokeWidth.thin" }
    },
    "shimmerContainer": { "bottom": 0, "left": 0, "overflow": "hidden", "pointerEvents": "none", "position": "absolute", "top": 0 },
    "gradient": { "stopColor": "tokens:color.backgroundNeutralSoft.rest", "centerOpacity": 0.64 }
  },
  "tokenGaps": []
}
