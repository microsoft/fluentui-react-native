{
  "schemaVersion": 2,
  "component": "tab",
  "implementation": "tab.styles.ts",
  "axes": [
    ["layout", ["iconAndText", "iconOnly"]],
    ["selected", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "alignItems": "center",
      "alignSelf": "flex-start",
      "borderStyle": "solid",
      "flexDirection": "row",
      "justifyContent": "center",
      "borderRadius": "tokens:borderRadius.base300",
      "gap": "tokens:spacing.componentBase100",
      "paddingHorizontal": "tokens:spacing.componentBase300",
      "paddingVertical": "tokens:spacing.componentBase150",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "when.layout.iconOnly": {
        "borderRadius": "tokens:borderRadius.circular",
        "gap": 0,
        "paddingHorizontal": "tokens:spacing.componentBase150"
      },
      "when.selected.true": {
        "backgroundColor": "tokens:color.backgroundBrandSoft.active",
        "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest" }
      }
    },
    "content": {
      "flexShrink": 1,
      "textAlign": "center",
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.selected.true": { "fontWeight": "tokens:fontWeight.functionalSemibold", "color": "tokens:color.foregroundBrandPrimary.active" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "icon": {
      "width": 20,
      "height": 20,
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.selected.true": { "color": "tokens:color.foregroundBrandPrimary.active" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    }
  },
  "tokenGaps": []
}
