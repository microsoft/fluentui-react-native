{
  "schemaVersion": 2,
  "component": "search-box",
  "implementation": "search-box.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["visualState", ["rest", "disabled"]]
  ],
  "bindings": {
    "searchIcon": {
      "source": "fluent-icon: Search20Regular",
      "width": 20,
      "height": 20,
      "when.size.small": {
        "width": 16,
        "height": 16
      },
      "when.size.large": {
        "width": 24,
        "height": 24
      },
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "clear": {
      "appearance": "subtle",
      "size": "small",
      "minWidth": 24
    }
  },
  "tokenGaps": [
    {
      "binding": "smallClearTarget",
      "detail": "Use a usable native small Button target rather than shrinking the press region to the source icon frame."
    }
  ]
}
