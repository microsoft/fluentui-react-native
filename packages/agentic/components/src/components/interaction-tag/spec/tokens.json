{
  "schemaVersion": 2,
  "component": "interaction-tag",
  "implementation": "interaction-tag.styles.ts",
  "axes": [
    ["appearance", ["secondary", "primary"]],
    ["size", ["small", "medium"]],
    ["shape", ["rounded", "circular"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "borderRadius": "tokens:borderRadius.base300",
      "when.size.small": {
        "borderRadius": "tokens:borderRadius.base200"
      },
      "when.shape.circular": {
        "borderRadius": "tokens:borderRadius.circular"
      }
    },
    "primary": {
      "flexDirection": "row",
      "alignItems": "center",
      "gap": "tokens:spacing.componentBase50",
      "paddingHorizontal": "tokens:spacing.componentBase200",
      "backgroundColor": "tokens:color.backgroundNeutralSubtle.active",
      "when.appearance.primary": {
        "backgroundColor": "tokens:color.backgroundNeutralHeavy.active"
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest"
      }
    },
    "divider": {
      "width": "tokens:strokeWidth.thin",
      "alignSelf": "stretch",
      "backgroundColor": "tokens:color.strokeNeutralSubtle.rest"
    },
    "remove": {
      "minWidth": 32,
      "when.size.small": {
        "minWidth": 24
      }
    },
    "removeIcon": {
      "width": 16,
      "height": 16,
      "when.size.small": {
        "width": 12,
        "height": 12
      }
    },
    "content": {
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.appearance.primary": {
        "color": "tokens:color.foregroundNeutralOnloud.rest"
      },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": []
}
