{
  "schemaVersion": 2,
  "component": "tree-item",
  "implementation": "tree-item.styles.ts",
  "axes": [
    ["layout", ["standard", "avatar", "checkbox"]],
    ["size", ["small", "medium"]],
    ["appearance", ["subtle", "subtleAlpha", "transparent"]],
    ["selected", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "primary": {
      "flexDirection": "row",
      "alignItems": "center",
      "minHeight": 32,
      "paddingHorizontal": "tokens:spacing.componentBase200",
      "paddingVertical": "tokens:spacing.componentBase150",
      "borderRadius": "tokens:borderRadius.base100",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "when.layout.avatar": {
        "minHeight": 40,
        "when.size.small": {
          "minHeight": 32
        }
      },
      "when.layout.checkbox": {
        "paddingVertical": 0
      },
      "when.size.small": {
        "minHeight": 24
      },
      "when.selected.true": {
        "backgroundColor": "tokens:color.backgroundNeutralSoft.active"
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest"
      },
      "when.appearance.transparent": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest"
      },
      "when.appearance.subtleAlpha": {
        "when.visualState.hovered": {
          "backgroundColor": "tokens:color.backgroundNeutralTranslucent.hover"
        },
        "when.visualState.pressed": {
          "backgroundColor": "tokens:color.backgroundNeutralTranslucent.pressed"
        }
      }
    },
    "label": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "flexShrink": 1,
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "description": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralSecondary.rest"
    },
    "leading": {
      "width": 20,
      "height": 20,
      "when.size.small": {
        "width": 16,
        "height": 16
      }
    },
    "chevron": {
      "width": 12,
      "height": 12
    }
  },
  "tokenGaps": [
    {
      "binding": "levelInset",
      "detail": "Multiply the logical indent step by the hierarchy depth; do not cache an absolute left margin per rendered row."
    }
  ]
}
