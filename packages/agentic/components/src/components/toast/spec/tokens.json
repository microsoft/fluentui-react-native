{
  "schemaVersion": 2,
  "component": "toast",
  "implementation": "toast.styles.ts",
  "axes": [["status", ["informational", "warning", "error", "success"]]],
  "bindings": {
    "root": {
      "backgroundColor": "tokens:color.surfaceNeutralNearer.rest",
      "borderRadius": "tokens:borderRadius.base400",
      "gap": "tokens:spacing.componentBase200",
      "padding": "tokens:spacing.componentBase400"
    },
    "statusIcon": {
      "width": 20,
      "height": 20,
      "when.status.informational": {
        "color": "tokens:color.foregroundNeutralPrimary.rest"
      },
      "when.status.warning": {
        "color": "tokens:color.foregroundWarningPrimary.rest"
      },
      "when.status.error": {
        "color": "tokens:color.foregroundDangerPrimary.rest"
      },
      "when.status.success": {
        "color": "tokens:color.foregroundSuccessPrimary.rest"
      }
    },
    "content": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "flexShrink": 1
    },
    "actions": {
      "flexDirection": "row",
      "alignItems": "center",
      "flexWrap": "wrap",
      "gap": "tokens:spacing.componentBase200"
    },
    "dismiss": {
      "size": "small",
      "appearance": "subtle"
    },
    "thumbnail": {
      "width": 72,
      "height": 72
    },
    "secondaryText": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralSecondary.rest"
    },
    "subtitle": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalCaption",
      "lineHeight": "tokens:lineHeight.functionalCaption",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralTertiary.rest"
    }
  },
  "tokenGaps": [
    {
      "binding": "statusArtwork",
      "detail": "Use size-correct Fluent status artwork (Info, Warning, Diamond Dismiss, Checkmark Circle). Qualify the 20-unit assets rather than assuming a smaller generated glyph is equivalent."
    }
  ]
}
