{
  "schemaVersion": 2,
  "component": "link",
  "implementation": "link.styles.ts",
  "axes": [
    ["typography", ["functional", "content"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "alignSelf": "flex-start",
      "maxWidth": "100%",
      "gap": "tokens:spacing.componentBase50",
      "borderRadius": "tokens:borderRadius.base100"
    },
    "content": {
      "color": "tokens:color.foregroundBrandPrimary.active",
      "textDecorationLine": "underline",
      "flexShrink": 1,
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "when.typography.content": {
        "fontFamily": "tokens:fontFamily.content",
        "fontSize": "tokens:fontSize.contentParagraphMedium",
        "fontWeight": "tokens:fontWeight.contentRegular",
        "lineHeight": "tokens:lineHeight.contentParagraphMedium"
      },
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "trailingIcon": {
      "width": 16,
      "height": 16
    }
  },
  "tokenGaps": [
    {
      "binding": "underline",
      "detail": "Use supported native Text decoration; exact dotted geometry and inline focus bounds require renderer evidence."
    }
  ]
}
