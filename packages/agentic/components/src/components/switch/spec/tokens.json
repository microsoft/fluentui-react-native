{
  "schemaVersion": 2,
  "component": "switch",
  "implementation": "switch.styles.ts",
  "axes": [
    ["layout", ["switch", "horizontal", "vertical"]],
    ["checked", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "container": {
      "alignSelf": "flex-start",
      "flexDirection": "column",
      "when.layout.horizontal": {
        "alignItems": "center",
        "flexDirection": "row"
      },
      "when.layout.vertical": {
        "alignItems": "flex-start"
      }
    },
    "root": {
      "alignItems": "center",
      "alignSelf": "flex-start",
      "backgroundColor": "transparent",
      "borderStyle": "solid",
      "justifyContent": "center",
      "minHeight": 36,
      "minWidth": 56,
      "paddingHorizontal": "tokens:spacing.componentBase200",
      "paddingVertical": "tokens:spacing.componentBase200",
      "borderRadius": "tokens:borderRadius.circular"
    },
    "track": {
      "alignItems": "center",
      "justifyContent": "center",
      "position": "relative",
      "borderStyle": "solid",
      "height": 20,
      "width": 40,
      "flexShrink": 0,
      "borderRadius": "tokens:borderRadius.circular",
      "borderWidth": "tokens:strokeWidth.thin",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "borderColor": "tokens:color.foregroundNeutralSecondary.active",
      "when.checked.true": {
        "backgroundColor": "tokens:color.backgroundNeutralHeavy.active",
        "borderColor": "tokens:color.strokeNeutralHeavy.active",
        "when.visualState.disabled": {
          "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest",
          "borderColor": "tokens:color.strokeNeutralDisabled.rest"
        }
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
        "borderColor": "tokens:color.strokeNeutralDisabled.rest"
      }
    },
    "thumb": {
      "height": 14,
      "width": 14,
      "position": "absolute",
      "start": 2,
      "top": 2,
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.foregroundNeutralSecondary.active",
      "when.checked.true": { "backgroundColor": "tokens:color.foregroundNeutralOnloud.active" },
      "when.visualState.disabled": { "backgroundColor": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "label": {
      "flexShrink": 1,
      "minWidth": 0,
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "beforeLabel": {
      "paddingStart": "tokens:spacing.componentBase200",
      "paddingEnd": "tokens:spacing.componentBase100"
    },
    "afterLabel": {
      "paddingStart": "tokens:spacing.componentBase100",
      "paddingEnd": "tokens:spacing.componentBase200"
    },
    "aboveLabel": {
      "paddingTop": "tokens:spacing.componentBase200",
      "paddingBottom": "tokens:spacing.componentBase100"
    },
    "motion": { "duration": "tokens:motion.durationBase100" }
  },
  "tokenGaps": []
}
