{
  "schemaVersion": 2,
  "component": "badge",
  "implementation": "badge.styles.ts",
  "axes": [
    ["size", ["small", "medium"]],
    ["shape", ["circular", "rounded"]],
    ["appearance", ["tint", "outline", "filled"]],
    ["color", ["informative", "danger", "success", "warning"]],
    ["layout", ["iconAndText", "iconOnly", "counter", "dot"]]
  ],
  "bindings": {
    "root": {
      "borderRadius": "tokens:borderRadius.circular",
      "borderWidth": 0,
      "borderColor": "tokens:color.strokeNeutralTransparent.rest",
      "gap": "tokens:spacing.componentBase50",
      "when.size.small": {
        "minHeight": 16,
        "paddingHorizontal": "tokens:spacing.componentBase100",
        "when.shape.rounded": { "borderRadius": "tokens:borderRadius.base100" },
        "when.layout.iconOnly": { "minWidth": 16 },
        "when.layout.counter": { "minWidth": 16 },
        "when.layout.dot": { "height": 6, "width": 6, "minHeight": 6 }
      },
      "when.size.medium": {
        "minHeight": 20,
        "paddingHorizontal": "tokens:spacing.componentBase150",
        "when.shape.rounded": { "borderRadius": "tokens:borderRadius.base200" },
        "when.layout.iconOnly": { "minWidth": 20 },
        "when.layout.counter": { "minWidth": 20 },
        "when.layout.dot": { "height": 8, "width": 8, "minHeight": 8 }
      },
      "when.layout.iconOnly": { "paddingHorizontal": 0 },
      "when.layout.counter": { "paddingHorizontal": "tokens:spacing.componentBase100" },
      "when.layout.dot": {
        "paddingHorizontal": 0,
        "borderWidth": "tokens:strokeWidth.thin",
        "borderColor": "tokens:color.strokeNeutralOnloud.rest"
      },
      "when.appearance.tint": { "backgroundColor": "tokens:color.surfaceNeutralNearer.rest" },
      "when.appearance.outline": {
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
        "borderWidth": "tokens:strokeWidth.thin",
        "borderColor": "tokens:color.strokeNeutralLoud.rest",
        "when.color.danger": { "borderColor": "tokens:color.strokeDangerLoud.rest" },
        "when.color.success": { "borderColor": "tokens:color.strokeSuccessLoud.rest" },
        "when.color.warning": { "borderColor": "tokens:color.strokeWarningLoud.rest" }
      },
      "when.appearance.filled": {
        "backgroundColor": "tokens:color.backgroundNeutralLoud.rest",
        "when.color.danger": { "backgroundColor": "tokens:color.backgroundDangerLoud.rest" },
        "when.color.success": { "backgroundColor": "tokens:color.backgroundSuccessLoud.rest" },
        "when.color.warning": { "backgroundColor": "tokens:color.backgroundWarningLoud.rest" }
      }
    },
    "tint": {
      "backgroundColor": "tokens:color.backgroundNeutralSoft.rest",
      "when.color.danger": { "backgroundColor": "tokens:color.backgroundDangerSoft.rest" },
      "when.color.success": { "backgroundColor": "tokens:color.backgroundSuccessSoft.rest" },
      "when.color.warning": { "backgroundColor": "tokens:color.backgroundWarningSoft.rest" }
    },
    "content": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.size.small": { "fontSize": "tokens:fontSize.functionalCaption", "lineHeight": "tokens:lineHeight.functionalCaption" },
      "when.size.medium": { "fontSize": "tokens:fontSize.functionalBodySmall", "lineHeight": "tokens:lineHeight.functionalBodySmall" },
      "when.color.danger": { "color": "tokens:color.foregroundDangerPrimary.rest" },
      "when.color.success": { "color": "tokens:color.foregroundSuccessPrimary.rest" },
      "when.color.warning": { "color": "tokens:color.foregroundWarningPrimary.rest" },
      "when.appearance.filled": {
        "color": "tokens:color.foregroundNeutralOnloud.rest",
        "when.color.informative": { "color": "tokens:color.foregroundNeutralOnloud.rest" },
        "when.color.danger": { "color": "tokens:color.foregroundDangerOnloud.rest" },
        "when.color.success": { "color": "tokens:color.foregroundSuccessOnloud.rest" },
        "when.color.warning": { "color": "tokens:color.foregroundWarningOnloud.rest" }
      }
    },
    "icon": {
      "width": 16,
      "height": 16,
      "when.size.small": { "width": 12, "height": 12 }
    },
    "statusIcon": {
      "when.size.small": {
        "source": "fluent-icon: Info12Regular",
        "when.color.danger": { "source": "fluent-icon: DiamondDismiss12Regular" },
        "when.color.success": { "source": "fluent-icon: CheckmarkCircle12Regular" },
        "when.color.warning": { "source": "fluent-icon: Warning12Regular" }
      },
      "when.size.medium": {
        "source": "fluent-icon: Info16Regular",
        "when.color.danger": { "source": "fluent-icon: DiamondDismiss16Regular" },
        "when.color.success": { "source": "fluent-icon: CheckmarkCircle16Regular" },
        "when.color.warning": { "source": "fluent-icon: Warning16Regular" }
      }
    }
  },
  "tokenGaps": [
    {
      "binding": "root and icon dimensions",
      "detail": "Status and notification minimum sizes and icon boxes have no mapped Flex component dimensions."
    }
  ]
}
