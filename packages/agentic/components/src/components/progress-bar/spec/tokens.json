{
  "schemaVersion": 2,
  "component": "progress-bar",
  "implementation": "progress-bar.styles.ts",
  "axes": [["status", ["neutral", "error", "success"]]],
  "bindings": {
    "root": { "alignSelf": "stretch", "flexShrink": 1, "gap": "tokens:spacing.componentBase100" },
    "header": {
      "alignItems": "center",
      "flexDirection": "row",
      "gap": "tokens:spacing.componentBase100",
      "justifyContent": "space-between",
      "minWidth": 0
    },
    "trailing": { "alignItems": "center", "flexDirection": "row", "flexShrink": 0, "gap": "tokens:spacing.componentBase100" },
    "label": {
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "flexGrow": 1,
      "flexShrink": 1,
      "minWidth": 0,
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium"
    },
    "valueText": {
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall"
    },
    "track": {
      "backgroundColor": "tokens:color.backgroundNeutralSoft.rest",
      "borderRadius": "tokens:borderRadius.circular",
      "height": "tokens:spacing.componentBase100",
      "overflow": "hidden",
      "position": "relative"
    },
    "indicator": {
      "bottom": 0,
      "start": 0,
      "top": 0,
      "position": "absolute",
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.foregroundNeutralPrimary.rest",
      "when.status.error": { "backgroundColor": "tokens:color.foregroundDangerPrimary.rest" },
      "when.status.success": { "backgroundColor": "tokens:color.foregroundSuccessPrimary.rest" }
    },
    "validationIcon": {
      "width": 16,
      "height": 16,
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.status.error": { "color": "tokens:color.foregroundDangerPrimary.rest" },
      "when.status.success": { "color": "tokens:color.foregroundSuccessPrimary.rest" }
    }
  },
  "tokenGaps": []
}
