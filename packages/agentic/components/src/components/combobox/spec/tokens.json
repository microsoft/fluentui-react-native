{
  "schemaVersion": 2,
  "component": "combobox",
  "implementation": "combobox.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "alignSelf": "stretch"
    },
    "editor": {
      "flexGrow": 1,
      "minWidth": 0
    },
    "trailingAffordance": {
      "width": 20,
      "height": 20,
      "when.size.small": {
        "width": 16,
        "height": 16
      },
      "when.size.large": {
        "width": 24,
        "height": 24
      },
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "list": {
      "flexShrink": 1
    }
  },
  "tokenGaps": []
}
