{
  "schemaVersion": 2,
  "component": "nav",
  "implementation": "nav.styles.ts",
  "axes": [["presentation", ["inline", "overlay"]]],
  "bindings": {
    "panel": {
      "width": 320,
      "maxWidth": "100%",
      "backgroundColor": "tokens:color.surfaceNeutralNearer.rest",
      "when.presentation.inline": {
        "borderEndWidth": "tokens:strokeWidth.thin",
        "borderColor": "tokens:color.strokeNeutralSubtle.rest"
      }
    },
    "header": {
      "paddingHorizontal": "tokens:spacing.layoutBase200",
      "paddingVertical": "tokens:spacing.layoutBase100"
    },
    "body": {
      "flexShrink": 1,
      "paddingHorizontal": "tokens:spacing.layoutBase100",
      "paddingVertical": "tokens:spacing.layoutBase100"
    },
    "footer": {
      "paddingHorizontal": "tokens:spacing.layoutBase200",
      "paddingVertical": "tokens:spacing.layoutBase100"
    },
    "scrim": {
      "backgroundColor": "tokens:color.overlayNeutralTranslucent.rest"
    }
  },
  "tokenGaps": []
}
