{
  "schemaVersion": 2,
  "component": "toggle-button",
  "implementation": "toggle-button.styles.ts",
  "axes": [
    ["selected", [false, true]],
    ["highContrast", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "when.selected.true": {
        "backgroundColor": "tokens:color.backgroundNeutralSoft.active",
        "borderColor": "transparent",
        "when.highContrast.true": { "borderColor": "tokens:color.strokeNeutralLoud.rest" },
        "when.visualState.disabled": {
          "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest",
          "borderColor": "transparent"
        }
      }
    },
    "content": {
      "when.selected.true": {
        "color": "tokens:color.foregroundNeutralPrimary.active",
        "fontWeight": "tokens:fontWeight.functionalSemibold",
        "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
      }
    }
  },
  "tokenGaps": [
    {
      "binding": "root.borderColor",
      "detail": "Selected needs a distinguishable high-contrast boundary. Qualify the native system-color mapping before claiming high-contrast support."
    }
  ]
}
