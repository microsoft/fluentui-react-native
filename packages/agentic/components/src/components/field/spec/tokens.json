{
  "schemaVersion": 2,
  "component": "field",
  "implementation": "field.styles.ts",
  "axes": [
    ["orientation", ["vertical", "horizontal"]],
    ["status", ["rest", "error", "warning", "success", "disabled"]],
    ["size", ["small", "medium", "large"]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "column",
      "gap": "tokens:spacing.componentBase100",
      "when.orientation.vertical": { "when.size.large": { "gap": "tokens:spacing.componentBase150" } },
      "when.orientation.horizontal": {
        "flexDirection": "row",
        "alignItems": "flex-start",
        "gap": "tokens:spacing.componentBase250",
        "when.size.large": { "gap": "tokens:spacing.componentBase300" }
      }
    },
    "controlColumn": {
      "flexShrink": 1,
      "gap": "tokens:spacing.componentBase100",
      "when.size.large": { "gap": "tokens:spacing.componentBase150" }
    },
    "messageStack": { "gap": "tokens:spacing.componentBase50" },
    "helper": {
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "fontFamily": "tokens:fontFamily.functional",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "when.size.small": { "fontSize": "tokens:fontSize.functionalCaption", "lineHeight": "tokens:lineHeight.functionalCaption" },
      "when.size.large": { "fontSize": "tokens:fontSize.functionalBodyMedium", "lineHeight": "tokens:lineHeight.functionalBodyMedium" }
    },
    "validationRow": { "flexDirection": "row", "alignItems": "flex-start", "gap": "tokens:spacing.componentBase50" },
    "validationText": {
      "flexShrink": 1,
      "fontFamily": "tokens:fontFamily.functional",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "when.size.small": { "fontSize": "tokens:fontSize.functionalCaption", "lineHeight": "tokens:lineHeight.functionalCaption" },
      "when.size.large": { "fontSize": "tokens:fontSize.functionalBodyMedium", "lineHeight": "tokens:lineHeight.functionalBodyMedium" },
      "when.status.error": { "color": "tokens:color.foregroundDangerPrimary.rest" },
      "when.status.warning": { "color": "tokens:color.foregroundWarningPrimary.rest" },
      "when.status.success": { "color": "tokens:color.foregroundSuccessPrimary.rest" }
    },
    "validationIcon": {
      "width": 16,
      "height": 16,
      "when.size.small": { "width": 12, "height": 12 },
      "when.status.error": {
        "color": "tokens:color.foregroundDangerPrimary.rest",
        "source": "fluent-icon: DiamondDismiss16Regular",
        "when.size.small": { "source": "fluent-icon: DiamondDismiss12Regular" }
      },
      "when.status.warning": {
        "color": "tokens:color.foregroundWarningPrimary.rest",
        "source": "fluent-icon: Warning16Regular",
        "when.size.small": { "source": "fluent-icon: Warning12Regular" }
      },
      "when.status.success": {
        "color": "tokens:color.foregroundSuccessPrimary.rest",
        "source": "fluent-icon: CheckmarkCircle16Regular",
        "when.size.small": { "source": "fluent-icon: CheckmarkCircle12Regular" }
      }
    }
  },
  "tokenGaps": []
}
