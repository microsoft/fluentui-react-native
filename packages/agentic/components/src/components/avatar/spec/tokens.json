{
  "schemaVersion": 2,
  "component": "avatar",
  "implementation": "avatar.styles.ts",
  "axes": [
    ["size", [16, 20, 24, 28, 32, 40, 56, 120]],
    ["contentMode", ["image", "icon", "initials"]]
  ],
  "bindings": {
    "root": {
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.backgroundNeutralSoft.rest",
      "when.size.16": { "width": 16, "height": 16, "minWidth": 16, "minHeight": 16, "padding": "tokens:spacing.componentBase50" },
      "when.size.20": { "width": 20, "height": 20, "minWidth": 20, "minHeight": 20, "padding": "tokens:spacing.componentBase50" },
      "when.size.24": { "width": 24, "height": 24, "minWidth": 24, "minHeight": 24, "padding": "tokens:spacing.componentBase100" },
      "when.size.28": { "width": 28, "height": 28, "minWidth": 28, "minHeight": 28, "padding": "tokens:spacing.componentBase150" },
      "when.size.32": { "width": 32, "height": 32, "minWidth": 32, "minHeight": 32, "padding": "tokens:spacing.componentBase100" },
      "when.size.40": { "width": 40, "height": 40, "minWidth": 40, "minHeight": 40, "padding": "tokens:spacing.componentBase200" },
      "when.size.56": { "width": 56, "height": 56, "minWidth": 56, "minHeight": 56, "padding": "tokens:spacing.componentBase300" },
      "when.size.120": { "width": 120, "height": 120, "minWidth": 120, "minHeight": 120, "padding": "tokens:spacing.layoutBase400" },
      "when.contentMode.image": { "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest", "padding": 0 }
    },
    "image": { "borderRadius": "tokens:borderRadius.circular" },
    "initials": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.size.16": { "fontSize": "tokens:fontSize.functionalCaption" },
      "when.size.20": { "fontSize": "tokens:fontSize.functionalCaption" },
      "when.size.24": { "fontSize": "tokens:fontSize.functionalCaption" },
      "when.size.28": { "fontSize": "tokens:fontSize.functionalBodySmall" },
      "when.size.32": { "fontSize": "tokens:fontSize.functionalBodyMedium" },
      "when.size.40": { "fontSize": "tokens:fontSize.functionalBodyLarge" },
      "when.size.56": { "fontSize": "tokens:fontSize.functionalTitleSmall" },
      "when.size.120": { "fontSize": "tokens:fontSize.functionalTitleLarge" }
    },
    "icon": {
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.size.16": { "width": 12, "height": 12 },
      "when.size.20": { "width": 16, "height": 16 },
      "when.size.24": { "width": 16, "height": 16 },
      "when.size.28": { "width": 16, "height": 16 },
      "when.size.32": { "width": 20, "height": 20 },
      "when.size.40": { "width": 24, "height": 24 },
      "when.size.56": { "width": 32, "height": 32 },
      "when.size.120": { "width": 48, "height": 48 }
    },
    "activityRing": {
      "borderColor": "tokens:color.strokeBrandLoud.rest",
      "borderRadius": "tokens:borderRadius.circular",
      "borderWidth": "tokens:strokeWidth.thick",
      "gap": "tokens:strokeWidth.thin",
      "when.size.16": { "borderWidth": "tokens:strokeWidth.thin" },
      "when.size.56": { "borderWidth": "tokens:strokeWidth.thicker" },
      "when.size.120": { "borderWidth": "tokens:strokeWidth.thicker", "gap": "tokens:strokeWidth.thick" }
    }
  },
  "tokenGaps": [
    {
      "binding": "Avatar and icon dimensions",
      "detail": "Numeric Avatar diameters and icon boxes have no mapped Flex component dimensions."
    }
  ]
}
