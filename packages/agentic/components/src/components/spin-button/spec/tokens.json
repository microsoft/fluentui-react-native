{
  "schemaVersion": 2,
  "component": "spin-button",
  "implementation": "spin-button.styles.ts",
  "axes": [["visualState", ["rest", "hovered", "pressed", "disabled"]]],
  "bindings": {
    "stepColumn": {
      "width": 24,
      "gap": 0
    },
    "stepIcon": {
      "width": 16,
      "height": 16,
      "color": "tokens:color.foregroundNeutralTertiary.active",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "editor": {
      "flexGrow": 1,
      "minWidth": 0
    }
  },
  "tokenGaps": [
    { "binding": "nativeSteppers", "detail": "AppKit owns field editing and stepper artwork; Field owns the explanatory error." }
  ]
}
