{
  "schemaVersion": 2,
  "component": "accordion",
  "implementation": "accordion.styles.ts",
  "axes": [
    ["layout", ["chevronStart", "chevronEnd"]],
    ["visualState", ["rest", "hovered", "pressed"]]
  ],
  "bindings": {
    "header": {
      "borderRadius": "tokens:borderRadius.base200",
      "gap": "tokens:spacing.componentBase100",
      "paddingHorizontal": "tokens:spacing.componentBase200",
      "paddingVertical": "tokens:spacing.componentBase100",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "when.visualState.hovered": { "backgroundColor": "tokens:color.backgroundNeutralSubtle.hover" },
      "when.visualState.pressed": { "backgroundColor": "tokens:color.backgroundNeutralSubtle.pressed" }
    },
    "title": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalSemibold",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "flexShrink": 1,
      "when.layout.chevronStart": { "flexBasis": 0, "flexGrow": 1 },
      "when.layout.chevronEnd": { "flexGrow": 0 }
    },
    "body": {
      "paddingHorizontal": "tokens:spacing.componentBase200",
      "paddingTop": "tokens:spacing.componentBase200"
    },
    "bodyPlaceholder": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "color": "tokens:color.foregroundNeutralPrimary.rest"
    },
    "chevronContainer": {
      "when.layout.chevronEnd": { "marginStart": "auto" }
    },
    "icon": { "height": 16, "width": 16 }
  },
  "tokenGaps": [
    { "binding": "icon dimensions", "detail": "The 16-unit disclosure and leading icon boxes have no mapped component token." },
    {
      "binding": "header.backgroundColor",
      "detail": "FURN uses Subtle hover and pressed fills to preserve visible neutral feedback across themes."
    },
    { "binding": "motion", "detail": "Timed chevron and panel motion is deferred; orientation and visibility change immediately." }
  ]
}
