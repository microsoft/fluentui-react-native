{
  "schemaVersion": 2,
  "component": "rating",
  "implementation": "rating.styles.ts",
  "axes": [["size", ["small", "medium", "large"]]],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "gap": "tokens:spacing.componentBase50",
      "when.size.small": {
        "gap": 0
      },
      "when.size.large": {
        "gap": "tokens:spacing.componentBase100"
      },
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest"
    }
  },
  "tokenGaps": []
}
