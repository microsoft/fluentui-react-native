{
  "schemaVersion": 2,
  "component": "list-item",
  "implementation": "list-item.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["secondaryContentPosition", ["under", "right"]],
    ["selectionMode", ["none", "single", "multiple"]],
    ["selected", [false, true]],
    ["selectedFill", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "alignItems": "center",
      "alignSelf": "stretch",
      "flexDirection": "row",
      "justifyContent": "flex-start",
      "width": "100%",
      "borderRadius": "tokens:borderRadius.base300",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "paddingHorizontal": "tokens:spacing.componentBase300",
      "paddingVertical": "tokens:spacing.componentBase250",
      "when.size.small": { "paddingHorizontal": "tokens:spacing.componentBase200", "paddingVertical": "tokens:spacing.componentBase150" },
      "when.size.large": { "paddingHorizontal": "tokens:spacing.componentBase400", "paddingVertical": "tokens:spacing.componentBase300" },
      "when.selectedFill.true": { "backgroundColor": "tokens:color.backgroundNeutralSoft.active" },
      "when.visualState.disabled": { "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest" }
    },
    "content": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.size.small": { "fontSize": "tokens:fontSize.functionalBodySmall", "lineHeight": "tokens:lineHeight.functionalBodySmall" },
      "when.size.large": { "fontSize": "tokens:fontSize.functionalBodyLarge", "lineHeight": "tokens:lineHeight.functionalBodyLarge" },
      "when.selected.true": { "fontWeight": "tokens:fontWeight.functionalSemibold" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "secondary": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "color": "tokens:color.foregroundNeutralSecondary.active",
      "when.size.large": { "fontSize": "tokens:fontSize.functionalBodyMedium", "lineHeight": "tokens:lineHeight.functionalBodyMedium" },
      "when.secondaryContentPosition.right": { "flexShrink": 0, "marginStart": "auto", "textAlign": "right" },
      "when.selected.true": { "color": "tokens:color.foregroundNeutralPrimary.active" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "leading": {
      "alignItems": "center",
      "flexShrink": 0,
      "justifyContent": "center",
      "marginEnd": "tokens:spacing.componentBase150",
      "when.size.small": { "marginEnd": "tokens:spacing.componentBase100" },
      "when.size.large": { "marginEnd": "tokens:spacing.componentBase200" }
    },
    "icon": {
      "height": 20,
      "width": 20,
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.size.small": { "height": 16, "width": 16 },
      "when.size.large": { "height": 24, "width": 24 },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" }
    },
    "avatar": {
      "alignItems": "center",
      "justifyContent": "center",
      "overflow": "hidden",
      "height": 32,
      "width": 32,
      "when.size.small": { "height": 20, "width": 20 },
      "when.size.large": { "height": 40, "width": 40 }
    },
    "trailing": {
      "alignItems": "center",
      "flexDirection": "row",
      "flexShrink": 0,
      "gap": "tokens:spacing.componentBase100",
      "marginStart": "tokens:spacing.componentBase200",
      "when.size.small": { "marginStart": "tokens:spacing.componentBase150" },
      "when.size.large": { "marginStart": "tokens:spacing.componentBase250" }
    },
    "contentGroup": { "when.secondaryContentPosition.under": { "gap": "tokens:spacing.componentBase100" } },
    "indicator": {
      "alignItems": "center",
      "justifyContent": "center",
      "flexShrink": 0,
      "borderStyle": "solid",
      "borderWidth": "tokens:strokeWidth.thin",
      "height": 16,
      "width": 16,
      "marginEnd": "tokens:spacing.componentBase200",
      "backgroundColor": "tokens:color.backgroundNeutralTransparent.active",
      "borderColor": "tokens:color.strokeNeutralHeavy.active",
      "when.size.small": { "marginEnd": "tokens:spacing.componentBase150" },
      "when.selectionMode.single": { "borderRadius": 8 },
      "when.selectionMode.multiple": {
        "borderRadius": "tokens:borderRadius.base100",
        "iconSize": 12,
        "iconColor": "tokens:color.foregroundNeutralOnloud.active",
        "when.selected.true": {
          "backgroundColor": "tokens:color.backgroundNeutralHeavy.active",
          "borderColor": "tokens:color.strokeNeutralTransparent.active",
          "when.visualState.disabled": {
            "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest",
            "borderColor": "tokens:color.strokeNeutralTransparent.rest"
          }
        }
      },
      "when.visualState.disabled": {
        "borderColor": "tokens:color.strokeNeutralDisabled.rest",
        "backgroundColor": "tokens:color.backgroundNeutralTransparent.rest",
        "iconColor": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "dot": {
      "height": 10,
      "width": 10,
      "borderRadius": 5,
      "backgroundColor": "tokens:color.foregroundNeutralPrimary.active",
      "when.visualState.disabled": { "backgroundColor": "tokens:color.foregroundNeutralDisabled.rest" }
    }
  },
  "tokenGaps": []
}
