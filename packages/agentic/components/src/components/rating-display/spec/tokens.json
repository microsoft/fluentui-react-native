{
  "schemaVersion": 2,
  "component": "rating-display",
  "implementation": "rating-display.styles.ts",
  "axes": [["size", ["small", "medium", "large"]]],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "gap": "tokens:spacing.componentBase200"
    },
    "stars": {
      "flexDirection": "row",
      "alignItems": "center",
      "gap": "tokens:spacing.componentBase50",
      "when.size.small": {
        "gap": 0
      },
      "when.size.large": {
        "gap": "tokens:spacing.componentBase100"
      }
    },
    "value": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralPrimary.rest"
    },
    "count": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralSecondary.rest"
    }
  },
  "tokenGaps": []
}
