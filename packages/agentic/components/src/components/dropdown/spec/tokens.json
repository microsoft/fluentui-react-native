{
  "schemaVersion": 2,
  "component": "dropdown",
  "implementation": "dropdown.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["open", [false, true]],
    ["focusVisible", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "focused", "error", "disabled", "readOnly"]]
  ],
  "bindings": {
    "value": {
      "when.size.small": { "lineHeight": "tokens:lineHeight.functionalBodySmall" },
      "when.size.medium": { "lineHeight": "tokens:lineHeight.functionalBodyMedium" },
      "when.size.large": { "lineHeight": "tokens:lineHeight.functionalBodyLarge" }
    },
    "chevron": {
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "when.focusVisible.true": { "color": "tokens:color.foregroundNeutralPrimary.rest" },
      "when.visualState.error": { "color": "tokens:color.foregroundNeutralPrimary.rest" },
      "when.visualState.disabled": { "color": "tokens:color.foregroundNeutralDisabled.rest" },
      "when.size.small": {
        "height": 16,
        "width": 16,
        "source": "fluent-icon:ChevronDown16Regular",
        "when.open.true": { "source": "fluent-icon:ChevronUp16Regular" }
      },
      "when.size.medium": {
        "height": 20,
        "width": 20,
        "source": "fluent-icon:ChevronDown20Regular",
        "when.open.true": { "source": "fluent-icon:ChevronUp20Regular" }
      },
      "when.size.large": {
        "height": 24,
        "width": 24,
        "source": "fluent-icon:ChevronDown24Regular",
        "when.open.true": { "source": "fluent-icon:ChevronUp24Regular" }
      }
    }
  },
  "tokenGaps": []
}
