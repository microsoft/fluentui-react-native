{
  "schemaVersion": 2,
  "component": "tag-picker",
  "implementation": "tag-picker.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "control": {
      "flexDirection": "row",
      "alignItems": "center",
      "flexWrap": "wrap",
      "minHeight": 44,
      "when.size.small": {
        "minHeight": 32
      },
      "when.size.large": {
        "minHeight": 52
      }
    },
    "tags": {
      "flexDirection": "row",
      "alignItems": "center",
      "flexWrap": "wrap",
      "gap": "tokens:spacing.componentBase50",
      "flexShrink": 1
    },
    "editor": {
      "flexGrow": 1
    },
    "chevron": {
      "width": 20,
      "height": 20,
      "when.size.small": {
        "width": 16,
        "height": 16
      },
      "when.size.large": {
        "width": 24,
        "height": 24
      },
      "color": "tokens:color.foregroundNeutralSecondary.rest",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": []
}
