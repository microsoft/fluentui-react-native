{
  "schemaVersion": 2,
  "component": "rating-item",
  "implementation": "rating-item.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["fill", ["empty", "half", "full"]],
    ["visualState", ["rest", "disabled"]]
  ],
  "bindings": {
    "root": {
      "width": 24,
      "height": 24
    },
    "glyph": {
      "width": 16,
      "height": 16,
      "outlineSource": "fluent-icon: Star16Regular",
      "filledSource": "fluent-icon: Star16Filled",
      "when.size.small": {
        "width": 12,
        "height": 12,
        "outlineSource": "fluent-icon: Star12Regular",
        "filledSource": "fluent-icon: Star12Filled"
      },
      "when.size.large": {
        "width": 20,
        "height": 20,
        "outlineSource": "fluent-icon: Star20Regular",
        "filledSource": "fluent-icon: Star20Filled"
      },
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "fillMask": {
      "when.fill.half": {
        "width": "50%"
      }
    }
  },
  "tokenGaps": []
}
