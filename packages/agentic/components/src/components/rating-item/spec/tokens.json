{
  "schemaVersion": 2,
  "component": "rating-item",
  "implementation": "rating-item.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["fill", ["empty", "half", "full"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "width": 24,
      "height": 24,
      "alignItems": "center",
      "justifyContent": "center"
    },
    "glyph": {
      "width": 16,
      "height": 16,
      "when.size.small": {
        "width": 12,
        "height": 12
      },
      "when.size.large": {
        "width": 20,
        "height": 20
      },
      "color": "tokens:color.foregroundNeutralPrimary.active",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    },
    "fillMask": {
      "overflow": "hidden",
      "when.fill.empty": {
        "width": 0
      },
      "when.fill.half": {
        "width": "50%"
      },
      "when.fill.full": {
        "width": "100%"
      }
    }
  },
  "tokenGaps": []
}
