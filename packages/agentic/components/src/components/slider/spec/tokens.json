{
  "schemaVersion": 2,
  "component": "slider",
  "implementation": "slider.styles.ts",
  "axes": [
    ["orientation", ["horizontal", "vertical"]],
    ["size", ["small", "medium", "large"]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "gap": "tokens:spacing.componentBase100"
    },
    "rail": {
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.backgroundNeutralSoft.rest",
      "when.orientation.horizontal": {
        "height": 4,
        "when.size.small": {
          "height": 2
        },
        "when.size.large": {
          "height": 4
        }
      },
      "when.orientation.vertical": {
        "width": 4,
        "when.size.small": {
          "width": 2
        },
        "when.size.large": {
          "width": 4
        }
      },
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralSubtleDisabled.rest"
      }
    },
    "track": {
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.backgroundBrandHeavy.active",
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest"
      }
    },
    "thumb": {
      "width": 20,
      "height": 20,
      "when.size.small": {
        "width": 16,
        "height": 16
      },
      "when.size.large": {
        "width": 24,
        "height": 24
      },
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.backgroundNeutralHeavy.active",
      "when.visualState.disabled": {
        "backgroundColor": "tokens:color.backgroundNeutralHeavyDisabled.rest"
      }
    },
    "hitTarget": {
      "width": 28,
      "height": 28,
      "when.size.small": {
        "width": 24,
        "height": 24
      },
      "when.size.large": {
        "width": 32,
        "height": 32
      }
    },
    "mark": {
      "width": 4,
      "height": 4,
      "when.size.small": {
        "width": 2,
        "height": 2
      },
      "when.size.large": {
        "width": 4,
        "height": 4
      },
      "borderRadius": "tokens:borderRadius.circular",
      "backgroundColor": "tokens:color.strokeNeutralLoud.rest"
    },
    "label": {
      "color": "tokens:color.foregroundNeutralPrimary.rest",
      "when.visualState.disabled": {
        "color": "tokens:color.foregroundNeutralDisabled.rest"
      }
    }
  },
  "tokenGaps": []
}
