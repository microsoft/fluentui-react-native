{
  "schemaVersion": 2,
  "component": "persona",
  "implementation": "persona.styles.ts",
  "axes": [
    ["layout", ["beforeAvatar", "afterAvatar", "belowAvatar"]],
    ["alignment", ["top", "center"]],
    ["size", [16, 20, 24, 28, 32, 40, 56, 120]]
  ],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "flex-start",
      "when.layout.beforeAvatar": {
        "flexDirection": "row-reverse",
        "justifyContent": "flex-end"
      },
      "when.layout.belowAvatar": {
        "flexDirection": "column"
      },
      "when.alignment.center": {
        "alignItems": "center"
      },
      "when.size.16": {
        "gap": "tokens:spacing.componentBase100"
      },
      "when.size.20": {
        "gap": "tokens:spacing.componentBase100"
      },
      "when.size.24": {
        "gap": "tokens:spacing.componentBase100"
      },
      "when.size.28": {
        "gap": "tokens:spacing.componentBase100"
      },
      "when.size.32": {
        "gap": "tokens:spacing.componentBase200"
      },
      "when.size.40": {
        "gap": "tokens:spacing.componentBase200"
      },
      "when.size.56": {
        "gap": "tokens:spacing.componentBase300"
      },
      "when.size.120": {
        "gap": "tokens:spacing.componentBase400"
      }
    },
    "textColumn": {
      "flexShrink": 1
    },
    "name": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalSemibold",
      "color": "tokens:color.foregroundNeutralPrimary.rest"
    },
    "supportingText": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodySmall",
      "lineHeight": "tokens:lineHeight.functionalBodySmall",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundNeutralSecondary.rest"
    }
  },
  "tokenGaps": []
}
