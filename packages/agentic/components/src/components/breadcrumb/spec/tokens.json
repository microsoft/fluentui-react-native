{
  "schemaVersion": 2,
  "component": "breadcrumb",
  "implementation": "breadcrumb.styles.ts",
  "axes": [["size", ["small", "medium", "large"]]],
  "bindings": {
    "root": {
      "flexDirection": "row",
      "alignItems": "center",
      "gap": "tokens:spacing.componentBase50",
      "when.size.large": {
        "gap": "tokens:spacing.componentBase100"
      }
    },
    "current": {
      "fontFamily": "tokens:fontFamily.functional",
      "fontSize": "tokens:fontSize.functionalBodyMedium",
      "lineHeight": "tokens:lineHeight.functionalBodyMedium",
      "fontWeight": "tokens:fontWeight.functionalRegular",
      "color": "tokens:color.foregroundBrandPrimary.rest",
      "flexShrink": 1,
      "when.size.small": { "fontSize": "tokens:fontSize.functionalBodySmall", "lineHeight": "tokens:lineHeight.functionalBodySmall" },
      "when.size.large": { "fontSize": "tokens:fontSize.functionalBodyLarge", "lineHeight": "tokens:lineHeight.functionalBodyLarge" }
    },
    "separator": {
      "color": "tokens:color.foregroundNeutralTertiary.rest",
      "width": 12,
      "height": 12,
      "when.size.large": { "width": 16, "height": 16 }
    },
    "overflowButton": {
      "minWidth": 32,
      "when.size.small": { "minWidth": 24 },
      "when.size.large": { "minWidth": 40 }
    }
  },
  "tokenGaps": []
}
