{
  "schemaVersion": 2,
  "component": "spinner",
  "implementation": "spinner.styles.ts",
  "axes": [["size", ["x-tiny", "tiny", "x-small", "small", "medium", "large", "x-large", "huge"]]],
  "bindings": {
    "root": { "alignItems": "center", "justifyContent": "center", "flexShrink": 0 },
    "svg": {
      "flexShrink": 0,
      "diameter": 32,
      "strokeWidth": "tokens:strokeWidth.thick",
      "when.size.x-tiny": { "diameter": 16, "strokeWidth": "tokens:strokeWidth.thin" },
      "when.size.tiny": { "diameter": 20, "strokeWidth": "tokens:strokeWidth.thin" },
      "when.size.x-small": { "diameter": 24, "strokeWidth": "tokens:strokeWidth.thin" },
      "when.size.small": { "diameter": 28 },
      "when.size.large": { "diameter": 36, "strokeWidth": "tokens:strokeWidth.thicker" },
      "when.size.x-large": { "diameter": 40, "strokeWidth": "tokens:strokeWidth.thicker" },
      "when.size.huge": { "diameter": 44, "strokeWidth": "tokens:strokeWidth.thicker" }
    },
    "track": { "stroke": "tokens:color.strokeNeutralSubtle.rest" },
    "indicator": { "stroke": "tokens:color.strokeNeutralLoud.rest" }
  },
  "tokenGaps": []
}
