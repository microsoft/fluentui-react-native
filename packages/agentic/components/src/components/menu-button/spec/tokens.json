{
  "schemaVersion": 2,
  "component": "menu-button",
  "implementation": "menu-button.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["highContrast", [false, true]],
    ["open", [false, true]],
    ["disabled", [false, true]]
  ],
  "bindings": {
    "root": {
      "when.highContrast.true": {
        "when.open.true": {
          "when.disabled.false": { "borderColor": "tokens:color.strokeFocusOuter.rest" }
        }
      }
    },
    "chevron": {
      "source": "fluent-icon: ChevronDown20Regular",
      "width": 20,
      "height": 20,
      "when.size.small": { "source": "fluent-icon: ChevronDown16Regular", "width": 16, "height": 16 }
    }
  },
  "tokenGaps": [
    {
      "binding": "motion",
      "detail": "Flex motion is pending; presentation and trigger color changes are instant (menu-button-motion)."
    }
  ]
}
