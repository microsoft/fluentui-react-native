{
  "schemaVersion": 2,
  "component": "color-picker",
  "implementation": "color-picker.styles.ts",
  "axes": [["orientation", ["horizontal", "vertical"]]],
  "bindings": {
    "root": {
      "maxWidth": 420,
      "gap": "tokens:spacing.componentBase300"
    },
    "controls": {
      "gap": "tokens:spacing.componentBase300",
      "when.orientation.horizontal": {
        "flexDirection": "row"
      },
      "when.orientation.vertical": {
        "flexDirection": "column"
      }
    },
    "rails": {
      "gap": "tokens:spacing.componentBase200"
    },
    "fields": {
      "flexDirection": "row",
      "alignItems": "center",
      "flexWrap": "wrap",
      "gap": "tokens:spacing.componentBase100"
    },
    "preview": {
      "width": 44,
      "height": 44,
      "borderWidth": "tokens:strokeWidth.thin",
      "borderColor": "tokens:color.strokeNeutralSubtle.rest"
    },
    "savedSlot": {
      "width": 32,
      "height": 32,
      "borderWidth": "tokens:strokeWidth.thin",
      "borderColor": "tokens:color.strokeNeutralSubtle.rest"
    }
  },
  "tokenGaps": [
    {
      "binding": "actualColor",
      "detail": "Preview and saved sample fills come from color data; chrome and input fields remain themeable."
    }
  ]
}
