{
  "schemaVersion": 2,
  "component": "color-slider",
  "implementation": "color-slider.styles.ts",
  "axes": [["orientation", ["horizontal", "vertical"]]],
  "bindings": {
    "rail": {
      "borderRadius": "tokens:borderRadius.circular",
      "overflow": "hidden",
      "borderWidth": "tokens:strokeWidth.thin",
      "borderColor": "tokens:color.strokeNeutralSubtle.rest",
      "when.orientation.horizontal": {
        "height": 12
      },
      "when.orientation.vertical": {
        "width": 12
      }
    },
    "thumb": {
      "width": 18,
      "height": 18,
      "borderRadius": "tokens:borderRadius.circular",
      "borderWidth": "tokens:strokeWidth.thick",
      "borderColor": "tokens:color.fixedWhite.rest"
    },
    "thumbCompanion": {
      "borderWidth": "tokens:strokeWidth.thin",
      "borderColor": "tokens:color.strokeNeutralHeavy.rest",
      "borderRadius": "tokens:borderRadius.circular"
    }
  },
  "tokenGaps": [
    {
      "binding": "channelRamp",
      "detail": "The hue ramp and alpha checkerboard/sample require a renderer-capable runtime paint path. Theme color tokens cannot encode the selected color."
    }
  ]
}
