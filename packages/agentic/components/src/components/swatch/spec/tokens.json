{
  "schemaVersion": 2,
  "component": "swatch",
  "implementation": "swatch.styles.ts",
  "axes": [
    ["size", ["small", "medium", "large"]],
    ["shape", ["circular", "square"]],
    ["selected", [false, true]],
    ["visualState", ["rest", "hovered", "pressed", "disabled"]]
  ],
  "bindings": {
    "root": {
      "width": 28,
      "height": 28,
      "when.size.small": {
        "width": 24,
        "height": 24
      },
      "when.size.large": {
        "width": 40,
        "height": 40
      },
      "alignItems": "center",
      "justifyContent": "center"
    },
    "sample": {
      "width": 28,
      "height": 28,
      "when.size.small": {
        "width": 20,
        "height": 20
      },
      "when.size.large": {
        "width": 40,
        "height": 40
      },
      "overflow": "hidden",
      "borderRadius": "tokens:borderRadius.circular",
      "when.shape.square": {
        "borderRadius": "tokens:borderRadius.base100"
      }
    },
    "boundary": {
      "borderWidth": "tokens:strokeWidth.thin",
      "borderColor": "tokens:color.strokeNeutralSubtle.active",
      "when.selected.true": {
        "borderColor": "tokens:color.strokeNeutralLoud.active"
      },
      "when.visualState.disabled": {
        "borderColor": "tokens:color.strokeNeutralDisabled.rest"
      }
    },
    "indicator": {
      "width": 16,
      "height": 16,
      "when.size.small": {
        "width": 12,
        "height": 12
      },
      "when.size.large": {
        "width": 20,
        "height": 20
      },
      "color": "tokens:color.foregroundNeutralOnloud.rest"
    }
  },
  "tokenGaps": []
}
