{
  "schemaVersion": 2,
  "component": "drawer",
  "implementation": "drawer.styles.ts",
  "axes": [
    ["position", ["start", "end", "bottom"]],
    ["size", ["small", "medium", "large", "full", "custom"]]
  ],
  "bindings": {
    "surface": {
      "backgroundColor": "tokens:color.surfaceNeutralNearer.rest",
      "borderColor": "tokens:color.strokeNeutralSubtle.rest",
      "when.position.bottom": {
        "borderTopLeftRadius": "tokens:borderRadius.base400",
        "borderTopRightRadius": "tokens:borderRadius.base400",
        "borderTopWidth": "tokens:strokeWidth.thin",
        "when.size.small": { "height": 320 },
        "when.size.medium": { "height": 592 },
        "when.size.large": { "height": 940 },
        "when.size.full": { "height": "100%" }
      },
      "when.position.start": {
        "borderEndWidth": "tokens:strokeWidth.thin",
        "maxWidth": "100%",
        "when.size.small": {
          "width": 320
        },
        "when.size.medium": {
          "width": 592
        },
        "when.size.large": {
          "width": 940
        },
        "when.size.full": {
          "width": "100%"
        }
      },
      "when.position.end": {
        "borderStartWidth": "tokens:strokeWidth.thin",
        "maxWidth": "100%",
        "when.size.small": {
          "width": 320
        },
        "when.size.medium": {
          "width": 592
        },
        "when.size.large": {
          "width": 940
        },
        "when.size.full": {
          "width": "100%"
        }
      }
    },
    "header": {
      "flexDirection": "row",
      "alignItems": "center",
      "minHeight": 48,
      "gap": "tokens:spacing.componentBase200",
      "paddingHorizontal": "tokens:spacing.layoutBase200",
      "paddingVertical": "tokens:spacing.layoutBase100"
    },
    "body": {
      "flexShrink": 1,
      "paddingHorizontal": "tokens:spacing.layoutBase200"
    },
    "footer": {
      "paddingHorizontal": "tokens:spacing.layoutBase200"
    }
  },
  "tokenGaps": [
    {
      "binding": "ownerExtent",
      "detail": "Preferred small/medium/large edge extents are 320/592/940 logical units, clamped to owner space. Full and custom depend on actual layout, not a fixed style."
    }
  ]
}
