{
  "platforms": ["macos", "windows"],
  "scenarios": [
    {
      "name": "components-button",
      "module": "@fluentui-react-native/components",
      "exports": ["Button"]
    },
    {
      "name": "components-catalog",
      "module": "@fluentui-react-native/components",
      "namespace": true
    },
    {
      "name": "design-theme-state",
      "module": "@fluentui-react-native/design",
      "exports": ["FlexThemeReference", "ThemeProvider", "useThemeState"],
      "forbiddenInputPatterns": ["/design/src/fluent/", "/design/src/test/", "/color-lib/"],
      "requiredInputPatterns": [
        "/design/src/flex/flexThemeReference.",
        "/design/src/flex/useThemeState.",
        "/design/src/theming/ThemeProvider."
      ]
    },
    {
      "name": "design-themed-root",
      "module": "@fluentui-react-native/design",
      "exports": ["ThemedRoot", "useRootSettings", "useThemeState"],
      "forbiddenInputPatterns": ["/design/src/fluent/", "/design/src/test/", "/color-lib/"],
      "requiredInputPatterns": ["/design/src/flex/useThemeState.", "/design/src/theming/ThemedRoot."]
    },
    {
      "name": "design-color-lib",
      "module": "@fluentui-react-native/design/color-lib",
      "exports": ["getContrastRatio", "getHoverColor", "getPressColor"],
      "requiredInputPatterns": ["/color-lib/compositing.", "/color-lib/conversion.", "/color-lib/interaction.", "/color-lib/parsing."]
    },
    {
      "name": "design-theme-state-legacy-source",
      "imports": [
        {
          "module": "@fluentui-react-native/design",
          "exports": ["ThemeProvider", "useThemeState"]
        },
        {
          "module": "@fluentui-react-native/design/theming/legacy-source",
          "exports": ["ThemeReference"]
        }
      ],
      "forbiddenInputPatterns": ["/design/src/fluent/compat/", "/design/src/fluent/tokens/", "/design/src/test/"],
      "requiredInputPatterns": ["/design/src/fluent/themeReference."]
    },
    {
      "name": "design-legacy-theme-from-flex",
      "module": "@fluentui-react-native/design/theming",
      "exports": ["FlexThemeReference", "ThemeProvider", "useTheme"],
      "requiredInputPatterns": [
        "/design/src/fluent/compat/themeFromFlexTokens.",
        "/design/src/fluent/tokens/",
        "/design/src/fluent/useTheme."
      ]
    }
  ]
}
