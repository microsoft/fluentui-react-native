{
  "name": "@fluentui-react-native/agentic-components-storybook",
  "version": "0.1.0",
  "private": true,
  "description": "On-device Storybook app for @fluentui-react-native/components",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui-react-native.git",
    "directory": "apps/storybook"
  },
  "scripts": {
    "start": "rnx-cli start",
    "storybook-desktop": "node ../../packages/agentic/storybook-desktop/config/cli.cjs",
    "pods:macos": "yarn storybook-desktop prep --macos",
    "pods:macos:update": "pod update --no-repo-update --project-directory=macos",
    "macos:build": "yarn storybook-desktop build --macos",
    "macos:build:clean": "xcodebuild -workspace macos/AgenticStorybook.xcworkspace -scheme AgenticStorybook -configuration Debug -destination 'platform=macOS' -derivedDataPath macos/DerivedData CODE_SIGNING_ALLOWED=NO clean build",
    "macos": "yarn storybook-desktop run --macos",
    "windows": "yarn storybook-desktop run --windows",
    "windows:cli": "react-native run-windows --arch x64 --sln windows/AgenticStorybook.sln",
    "windows:info": "react-native run-windows --info --no-telemetry",
    "windows:build": "yarn storybook-desktop build --windows",
    "windows:register": "pwsh -NoProfile -File scripts/register-windows-app.ps1",
    "windows:deploy": "yarn windows:build && yarn windows:register",
    "windows:launch-only": "pwsh -NoProfile -File scripts/launch-windows-app.ps1",
    "windows:ci": "yarn bundle:windows && yarn windows:generate && yarn windows:build",
    "windows:offline": "yarn bundle:windows && yarn windows:generate && yarn windows:cli --release --no-packager --no-deploy --no-launch --msbuildprops UseBundle=false && pwsh -NoProfile -File scripts/run-windows-offline.ps1",
    "windows:generate": "yarn storybook-desktop prep --windows",
    "windows:agent": "pwsh -NoProfile -File scripts/start-windows-agent-session.ps1 -RunSmokeTest",
    "windows:agent:start": "pwsh -NoProfile -File scripts/start-windows-agent-session.ps1",
    "windows:agent:stop": "pwsh -NoProfile -File scripts/stop-windows-agent-session.ps1",
    "windows:test": "jest --config jest.windows.config.cjs --runInBand",
    "bundle:macos": "yarn storybook-desktop bundle --macos",
    "bundle:win32": "yarn storybook-desktop bundle --win32",
    "bundle:win32:dev": "yarn prebuild:win32 && cross-env FURN_STORYBOOK_PLATFORM=win32 rnx-cli bundle --platform win32",
    "bundle:windows": "yarn storybook-desktop bundle --windows",
    "win32": "yarn storybook-desktop run --win32",
    "win32:ci": "yarn bundle:win32 && pwsh -NoProfile -File scripts/run-win32-ci.ps1",
    "win32:ci:host": "node scripts/run-win32.cjs --ci",
    "win32:dev": "node scripts/run-win32.cjs --dev",
    "smoke:macos": "yarn storybook-desktop smoke --macos",
    "smoke:windows": "yarn storybook-desktop smoke --windows",
    "smoke:win32": "yarn storybook-desktop smoke --win32",
    "prebuild": "sb-rn-get-stories --config-path src",
    "prebuild:macos": "cross-env FURN_STORYBOOK_PLATFORM=macos sb-rn-get-stories --config-path src",
    "prebuild:win32": "cross-env FURN_STORYBOOK_PLATFORM=win32 sb-rn-get-stories --config-path src",
    "prebuild:windows": "cross-env FURN_STORYBOOK_PLATFORM=windows sb-rn-get-stories --config-path src",
    "storybook-server": "yarn storybook-desktop server",
    "storybook:control": "node scripts/storybook-control.cjs",
    "storybook:smoke": "node scripts/storybook-control.cjs smoke",
    "storybook:smoke:win32": "cross-env STORYBOOK_SMOKE_FAIL_FAST=1 STORYBOOK_SMOKE_SETTLE_MS=250 node scripts/storybook-control.cjs smoke",
    "lint": "fluentui-scripts lint",
    "format": "fluentui-scripts format"
  },
  "dependencies": {
    "@fluentui-react-native/callout": "workspace:*",
    "@fluentui-react-native/components": "workspace:*",
    "@fluentui-react-native/focus-zone": "workspace:*",
    "@fluentui-react-native/storybook-desktop": "workspace:*",
    "@office-iss/react-native-win32": "^0.81.0",
    "@types/react": "~19.1.4",
    "react": "19.1.4",
    "react-native": "^0.81.6",
    "react-native-macos": "^0.81.0",
    "react-native-svg": "^15.12.1",
    "react-native-windows": "^0.81.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@fluentui-react-native/scripts": "workspace:*",
    "@office-iss/rex-win32": "0.81.1",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native-windows/automation": "0.81.32",
    "@react-native-windows/cli": "^0.81.0",
    "@react-native/babel-preset": "^0.81.0",
    "@react-native/metro-babel-transformer": "^0.81.0",
    "@react-native/metro-config": "^0.81.0",
    "@rnx-kit/cli": "catalog:",
    "@storybook/addon-ondevice-actions": "^10.4.7",
    "@storybook/addon-ondevice-controls": "^10.4.7",
    "@storybook/react-native": "^10.4.7",
    "cross-env": "catalog:",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "metro": "^0.83.1",
    "react-native-test-app": "catalog:",
    "storybook": "^10.4.0"
  },
  "furn": {
    "knip": {
      "ignoreDependencies": [
        "@fluentui-react-native/callout",
        "@fluentui-react-native/components",
        "@fluentui-react-native/focus-zone",
        "react-native-svg"
      ]
    }
  },
  "rnx-kit": {
    "kitType": "app",
    "bundle": [
      {
        "id": "main",
        "entryFile": "index.js",
        "assetsDest": "dist",
        "targets": [
          "macos",
          "win32",
          "windows"
        ],
        "plugins": [
          [
            "@rnx-kit/metro-plugin-duplicates-checker",
            {
              "throwOnError": true,
              "ignoredModules": [
                "pretty-format",
                "react-is"
              ]
            }
          ]
        ],
        "platforms": {
          "macos": {
            "bundleOutput": "dist/index.macos.jsbundle",
            "sourcemapOutput": "dist/index.macos.jsbundle.map"
          },
          "win32": {
            "bundleOutput": "dist/index.win32.bundle",
            "sourcemapOutput": "dist/index.win32.bundle.map"
          },
          "windows": {
            "bundleOutput": "dist/index.windows.bundle",
            "sourcemapOutput": "dist/index.windows.bundle.map"
          }
        }
      }
    ],
    "alignDeps": {
      "requirements": {
        "production": [
          "react-native@0.81"
        ]
      },
      "capabilities": [
        "babel-preset-react-native",
        "community/cli",
        "core",
        "core-macos",
        "core-win32",
        "core-windows",
        "core/metro-config",
        "metro-react-native-babel-transformer",
        "metro"
      ]
    },
    "extends": "@fluentui-react-native/scripts/kit-config"
  }
}
